<!-- views/dashboard/sidebar.ejs -->
<div class="wl-card border shadow-sm p-0 overflow-hidden" style="border-radius: var(--wl-radius-lg);">
  <!-- User Profile Summary in Rail -->
  <div class="p-4 text-center border-bottom bg-white">
    <% if (currentUser && currentUser.profilePictureUrl) { %>
      <img
        src="<%= currentUser.profilePictureUrl %>"
        alt="<%= currentUser.username %>"
        class="rounded-circle mb-3 shadow-sm border"
        style="width: 72px; height: 72px; object-fit: cover;"
      />
    <% } else { %>
      <div
        class="rounded-circle text-white d-inline-flex align-items-center justify-content-center mb-3 shadow-sm"
        style="width: 72px; height: 72px; font-size: 1.8rem; font-weight: 700; background-color: var(--wl-teal-500);"
      >
        <%= currentUser ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
      </div>
    <% } %>

    <h2 class="h6 mb-1 fw-bold text-dark text-truncate">
      <%= currentUser ? currentUser.username : 'User' %>
    </h2>

    <div class="d-flex align-items-center justify-content-center gap-1 flex-wrap mt-1">
      <%
        const roleBadgeStyles = {
          customer: 'background-color: var(--wl-teal-100); color: var(--wl-teal-800);',
          owner:    'background-color: #E2ECF8; color: #154D8A;',
          admin:    'background-color: var(--wl-danger-bg); color: var(--wl-danger-text);',
        };
        const roleDisplay = {
          customer: 'Customer',
          owner:    'Property / Venue Owner',
          admin:    'Admin',
        };
      %>
      <span class="badge rounded-pill px-2 py-1 fw-semibold" style="<%= roleBadgeStyles[currentUser.role] || 'background-color: #F1F4F5; color: var(--wl-ink);' %> font-size: 0.72rem;">
        <%= roleDisplay[currentUser.role] || currentUser.role %>
      </span>

      <% if (currentUser.role === 'owner') { %>
        <%
          const statusClass = {
            pending:  'wl-pill-pending',
            approved: 'wl-pill-approved',
            rejected: 'wl-pill-rejected',
          };
        %>
        <span class="wl-pill <%= statusClass[currentUser.ownerStatus] || 'wl-pill-pending' %> ms-1" style="font-size: 0.72rem; padding: 2px 8px;">
          <span class="wl-pill-dot"></span>
          <%= currentUser.ownerStatus === 'approved' ? 'Approved' : (currentUser.ownerStatus === 'rejected' ? 'Rejected' : 'Pending Approval') %>
        </span>
      <% } %>
    </div>
  </div>

  <!-- Navigation Section Items -->
  <div class="py-2 bg-white">
    <% if (typeof sections !== 'undefined' && sections && sections.length) { %>
      <% for (const sec of sections) { %>
        <%
          const isActive = (typeof activeSection !== 'undefined' && activeSection === sec.key);
          const isDisabled = sec.enabled === false;
        %>
        <% if (isDisabled) { %>
          <div
            class="d-flex align-items-center justify-content-between px-4 py-3 text-muted"
            style="cursor: not-allowed; opacity: 0.6; font-size: 0.93rem;"
          >
            <div class="d-flex align-items-center gap-3">
              <i class="<%= sec.icon || 'fa-solid fa-circle' %> text-muted" style="width: 18px;"></i>
              <span class="fw-medium"><%= sec.label %></span>
            </div>
            <span class="badge rounded-pill bg-light text-muted border" style="font-size: 0.68rem;">Soon</span>
          </div>
        <% } else { %>
          <a
            href="<%= sec.path %>"
            class="d-flex align-items-center justify-content-between px-4 py-3 text-decoration-none <%= isActive ? 'active' : '' %>"
            style="
              <%= isActive ? 'background-color: var(--wl-accent-50); color: var(--wl-accent-600); border-left: 4px solid var(--wl-accent); font-weight: 700;' : 'color: var(--wl-text); border-left: 4px solid transparent; font-weight: 500;' %>
              font-size: 0.93rem;
              transition: all 140ms ease;
            "
          >
            <div class="d-flex align-items-center gap-3">
              <i class="<%= sec.icon || 'fa-solid fa-circle' %>" style="width: 18px; <%= isActive ? 'color: var(--wl-accent-600);' : 'color: var(--wl-muted);' %>"></i>
              <span><%= sec.label %></span>
            </div>

            <% if (sec.key === 'approvals' && typeof pendingOwnerCount === 'number' && pendingOwnerCount > 0) { %>
              <span class="badge rounded-pill bg-danger text-white px-2 py-1" style="font-size: 0.72rem;">
                <%= pendingOwnerCount %>
              </span>
            <% } %>
          </a>
        <% } %>
      <% } %>
    <% } %>
  </div>
</div>
