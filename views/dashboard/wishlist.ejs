<% layout("dashboard/layout") -%>

<!-- Breadcrumb -->
<div class="wl-breadcrumb">
  <a href="/dashboard" class="text-muted text-decoration-none">Dashboard</a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
  <span class="text-dark fw-semibold">My Wishlist</span>
</div>

<div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
  <div class="d-flex align-items-center gap-3">
    <h1 class="h3 fw-bold text-dark mb-0">My Wishlist</h1>
    <% if (wishlist && wishlist.length > 0) { %>
      <span class="badge rounded-pill bg-white border text-dark px-3 py-2 fw-semibold" style="font-size: 0.82rem; border-color: var(--wl-border) !important;">
        <%= wishlist.length %> <%= wishlist.length === 1 ? 'saved listing' : 'saved listings' %>
      </span>
    <% } %>
  </div>
  <div class="text-muted fst-italic small">
    Dream today. Travel tomorrow.
  </div>
</div>

<% if (!wishlist || wishlist.length === 0) { %>
  <!-- Empty State -->
  <div class="wl-card text-center p-5 my-4">
    <div class="wl-empty-state py-4">
      <svg width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="var(--wl-teal-500)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
      </svg>
      <h3 class="h4 fw-bold text-dark mt-3 mb-2">Your wishlist is empty</h3>
      <p class="text-muted mb-4" style="max-width: 440px; margin: 0 auto;">
        Explore vacation stays, villas, and venues and tap the heart icon on any card to save your favorites here.
      </p>
      <a href="/listings" class="btn wl-btn-primary px-4">
        Explore Listings
      </a>
    </div>
  </div>
<% } else { %>
  <!-- Wishlist 3-Column Grid (Mockup Ref 08) -->
  <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <% for (let item of wishlist) { %>
      <div class="col" id="wishlist-item-<%= item.id %>">
        <div class="wl-listing-card">
          <!-- Image with Filled Heart -->
          <div class="wl-listing-img-wrap">
            <a href="/listings/<%= item.id %>" class="d-block w-100 h-100">
              <img
                src="<%= item.image ? item.image.url : '/images/landing_hero.jpg' %>"
                class="wl-listing-img"
                alt="<%= item.title %>"
                loading="lazy"
              />
            </a>
            <span class="wl-heart-btn is-saved" aria-label="Saved in wishlist">
              <i class="fa-solid fa-heart text-danger"></i>
            </span>
          </div>

          <!-- Card Content Body -->
          <div class="wl-listing-body">
            <h2 class="wl-listing-title text-truncate" title="<%= item.title %>">
              <a href="/listings/<%= item.id %>" class="text-decoration-none text-dark">
                <%= item.title %>
              </a>
            </h2>
            <div class="wl-listing-location text-truncate">
              <i class="fa-solid fa-location-dot text-muted"></i>
              <span><%= item.location %>, <%= item.country %></span>
            </div>
            <div class="wl-listing-footer mb-3">
              <span class="wl-listing-price">
                &#8377;<%= item.price ? item.price.toLocaleString("en-IN") : 'N/A' %>
              </span>
              <span class="wl-listing-unit">/ night</span>
            </div>

            <!-- Card Actions -->
            <div class="d-flex gap-2 mt-auto">
              <a href="/listings/<%= item.id %>" class="btn wl-btn-primary flex-grow-1 py-2 text-center" style="font-size: 0.88rem;">
                View
              </a>
              <form
                action="/wishlist/<%= item.id %>?_method=DELETE"
                method="POST"
                class="d-inline"
              >
                <button
                  type="submit"
                  class="btn wl-btn-outline d-flex align-items-center gap-1 py-2 px-3"
                  style="font-size: 0.88rem;"
                  title="Remove from wishlist"
                >
                  <i class="fa-regular fa-trash-can text-danger"></i>
                  <span>Remove</span>
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
