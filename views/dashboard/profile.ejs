<% layout("dashboard/layout") -%>

<!-- Breadcrumb -->
<div class="wl-breadcrumb">
  <a href="/dashboard" class="text-muted text-decoration-none">Dashboard</a>
  <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
  <span class="text-dark fw-semibold">My Profile</span>
</div>

<div class="mb-4">
  <h1 class="h3 fw-bold text-dark mb-1">My Profile</h1>
  <p class="text-muted small mb-0">Manage your account settings and personal details.</p>
</div>

<div class="row g-4">
  <!-- Left: Profile Overview Card -->
  <div class="col-12 col-lg-5">
    <div class="wl-card p-4 h-100">
      <div class="text-center pb-4 border-bottom">
        <div class="mb-3 position-relative d-inline-block">
          <% if (user.profilePictureUrl) { %>
            <img
              src="<%= user.profilePictureUrl %>"
              alt="<%= user.username %>"
              class="rounded-circle shadow-sm border"
              style="width: 110px; height: 110px; object-fit: cover;"
            />
          <% } else { %>
            <div
              class="rounded-circle text-white d-inline-flex align-items-center justify-content-center shadow-sm"
              style="width: 110px; height: 110px; font-size: 2.8rem; font-weight: 700; background-color: var(--wl-teal-500);"
            >
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
          <% } %>
        </div>

        <h2 class="h5 fw-bold text-dark mb-1"><%= user.username %></h2>
        <p class="text-muted small mb-2"><%= user.email %></p>

        <%
          const roleBadgeStyles = {
            customer: 'background-color: var(--wl-teal-100); color: var(--wl-teal-800);',
            owner:    'background-color: #E2ECF8; color: #154D8A;',
            admin:    'background-color: var(--wl-danger-bg); color: var(--wl-danger-text);',
          };
          const roleDisplay = { customer: 'Customer', owner: 'Property / Venue Owner', admin: 'Administrator' };
        %>
        <div>
          <span class="badge rounded-pill px-3 py-1 fw-semibold" style="<%= roleBadgeStyles[user.role] || 'background-color: #F1F4F5; color: var(--wl-ink);' %> font-size: 0.78rem;">
            <%= roleDisplay[user.role] || user.role %>
          </span>
          <% if (user.role === 'owner') { %>
            <%
              const statusClass = {
                pending:  'wl-pill-pending',
                approved: 'wl-pill-approved',
                rejected: 'wl-pill-rejected',
              };
            %>
            <span class="wl-pill <%= statusClass[user.ownerStatus] || 'wl-pill-pending' %> ms-1">
              <span class="wl-pill-dot"></span>
              <%= user.ownerStatus === 'approved' ? 'Approved' : (user.ownerStatus === 'rejected' ? 'Rejected' : 'Pending Approval') %>
            </span>
          <% } %>
        </div>
      </div>

      <!-- Overview Details List -->
      <div class="pt-4 d-flex flex-column gap-3">
        <div class="d-flex align-items-center justify-content-between text-muted small">
          <span class="d-flex align-items-center gap-2">
            <i class="fa-regular fa-envelope text-muted" style="width: 16px;"></i>
            <span>Email</span>
          </span>
          <span class="text-dark fw-medium text-truncate" style="max-width: 180px;"><%= user.email %></span>
        </div>

        <div class="d-flex align-items-center justify-content-between text-muted small">
          <span class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-phone text-muted" style="width: 16px;"></i>
            <span>Phone</span>
          </span>
          <span class="text-dark fw-medium"><%= user.phone || 'Not provided' %></span>
        </div>

        <div class="d-flex align-items-start justify-content-between text-muted small">
          <span class="d-flex align-items-center gap-2">
            <i class="fa-regular fa-comment-dots text-muted" style="width: 16px;"></i>
            <span>Bio</span>
          </span>
          <span class="text-dark fw-medium text-end fst-italic" style="max-width: 200px;">
            <%= user.bio || 'No bio provided yet.' %>
          </span>
        </div>

        <div class="d-flex align-items-center justify-content-between text-muted small">
          <span class="d-flex align-items-center gap-2">
            <i class="fa-regular fa-calendar text-muted" style="width: 16px;"></i>
            <span>Member Since</span>
          </span>
          <span class="text-dark fw-medium">
            <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : 'N/A' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right: Edit Profile Form -->
  <div class="col-12 col-lg-7">
    <div class="wl-card p-4">
      <div class="mb-4 pb-2 border-bottom">
        <h2 class="h5 fw-bold text-dark mb-1">Edit Profile</h2>
        <p class="text-muted small mb-0">Keep your information up to date</p>
      </div>

      <form
        action="/dashboard/profile?_method=PUT"
        method="POST"
        enctype="multipart/form-data"
        class="needs-validation"
        novalidate
      >
        <!-- Username -->
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <div class="wl-input-icon-group">
            <i class="fa-regular fa-user wl-lead-icon"></i>
            <input
              type="text"
              class="form-control"
              id="username"
              name="username"
              value="<%= user.username %>"
              required
              minlength="3"
              maxlength="50"
            />
          </div>
          <div class="invalid-feedback">Username must be between 3 and 50 characters.</div>
        </div>

        <!-- Email (Read-Only) -->
        <div class="mb-3">
          <label class="form-label">Email address</label>
          <div class="wl-input-icon-group">
            <i class="fa-solid fa-lock wl-lead-icon"></i>
            <input
              type="email"
              class="form-control"
              value="<%= user.email %>"
              readonly
            />
          </div>
          <div class="form-text">Email address cannot be modified.</div>
        </div>

        <!-- Role (Read-Only) -->
        <div class="mb-3">
          <label class="form-label">Role</label>
          <div class="wl-input-icon-group">
            <i class="fa-solid fa-shield-halved wl-lead-icon"></i>
            <input
              type="text"
              class="form-control"
              value="<%= roleDisplay[user.role] || user.role %>"
              readonly
            />
          </div>
          <div class="form-text">Role cannot be modified from profile settings.</div>
        </div>

        <!-- Phone -->
        <div class="mb-3">
          <label for="phone" class="form-label">Phone Number</label>
          <div class="wl-input-icon-group">
            <i class="fa-solid fa-phone wl-lead-icon"></i>
            <input
              type="tel"
              class="form-control"
              id="phone"
              name="phone"
              value="<%= user.phone || '' %>"
              placeholder="+91 98765 43210"
              maxlength="20"
            />
          </div>
          <div class="form-text">Optional contact phone number.</div>
        </div>

        <!-- Bio with Live Counter -->
        <div class="mb-3">
          <div class="d-flex align-items-center justify-content-between">
            <label for="bio" class="form-label">Bio</label>
            <span id="bio-counter" class="text-muted small">0/300</span>
          </div>
          <textarea
            class="form-control"
            id="bio"
            name="bio"
            rows="3"
            maxlength="300"
            placeholder="Tell others a little about yourself..."
          ><%= user.bio || '' %></textarea>
        </div>

        <!-- Avatar Dropzone -->
        <div class="mb-4">
          <label for="avatar" class="form-label">Profile photo</label>
          <div class="wl-dropzone">
            <input
              type="file"
              id="avatar"
              name="avatar"
              accept="image/*"
            />
            <div class="wl-dropzone-content">
              <div class="wl-dropzone-icon">
                <i class="fa-regular fa-image"></i>
              </div>
              <div class="fw-semibold text-dark" style="font-size: 0.92rem;">
                <%= user.profilePictureUrl ? 'Click or drag a new photo to replace' : 'Drag and drop a photo here or click to browse' %>
              </div>
              <div class="text-muted small mt-1">
                Max 2 MB &middot; JPEG, PNG or WebP
              </div>
            </div>
            <div class="wl-dropzone-preview text-center" style="display: none;">
              <img
                src=""
                alt="New Avatar"
                class="rounded-circle shadow-sm border mb-2"
                style="width: 72px; height: 72px; object-fit: cover;"
              />
              <div class="small text-teal-600 fw-semibold">New photo selected &middot; Click to replace</div>
            </div>
            <div class="wl-dropzone-error text-danger small mt-2"></div>
          </div>

          <% if (user.profilePictureUrl) { %>
            <div class="form-check mt-3">
              <input
                type="checkbox"
                class="form-check-input"
                id="removeAvatar"
                name="removeAvatar"
                value="true"
              />
              <label class="form-check-label text-danger small" for="removeAvatar">
                <i class="fa-solid fa-trash me-1"></i> Remove current profile picture
              </label>
            </div>
          <% } %>
        </div>

        <!-- Submit Button -->
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn wl-btn-primary px-4">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
