<% layout("layouts/boilerplate") -%>

<div class="wl-container py-4 py-md-5">
  <div class="mb-4">
    <h1 class="h3 fw-bold text-dark mb-1">Owner Approvals</h1>
    <p class="text-muted small mb-0">Review and manage owner registrations for the WanderLust marketplace.</p>
  </div>

  <!-- Tabs Bar (Mockup Ref 05) -->
  <!-- Tabs Bar (Mockup Ref 05) -->
  <div class="wl-tabs">
    <a
      href="/admin/owners?status=pending"
      class="wl-tab-item <%= filter === 'pending' ? 'active' : '' %>"
    >
      Pending <span class="badge wl-pill-count"><%= counts.pending %></span>
    </a>

    <a
      href="/admin/owners?status=approved"
      class="wl-tab-item <%= filter === 'approved' ? 'active' : '' %>"
    >
      Approved <span class="badge wl-pill-count"><%= counts.approved %></span>
    </a>

    <a
      href="/admin/owners?status=rejected"
      class="wl-tab-item <%= filter === 'rejected' ? 'active' : '' %>"
    >
      Rejected <span class="badge wl-pill-count"><%= counts.rejected %></span>
    </a>

    <a
      href="/admin/owners?status=info_requested"
      class="wl-tab-item <%= filter === 'info_requested' ? 'active' : '' %>"
    >
      Info Requested <span class="badge wl-pill-count"><%= counts.info_requested || 0 %></span>
    </a>

    <a
      href="/admin/owners?status=all"
      class="wl-tab-item <%= filter === 'all' ? 'active' : '' %>"
    >
      All <span class="badge wl-pill-count"><%= counts.all %></span>
    </a>
  </div>

  <% if (!owners || owners.length === 0) { %>
    <!-- Empty State (Mockup Ref 06) -->
    <div class="wl-card text-center p-5 my-4">
      <div class="wl-empty-state py-4">
        <svg width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="var(--wl-teal-500)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <polyline points="17 11 19 13 23 9"></polyline>
        </svg>
        <h3 class="h4 fw-bold text-dark mt-3 mb-2">No owner applications found</h3>
        <p class="text-muted mb-0" style="max-width: 440px; margin: 0 auto;">
          There are no owner registrations matching the "<%= filter %>" filter.
        </p>
      </div>
    </div>
  <% } else { %>
    <!-- Table Container (Mockup Ref 05) -->
    <div class="wl-table-container">
      <table class="wl-table">
        <thead>
          <tr>
            <th>Owner</th>
            <th>Business</th>
            <th>Type</th>
            <th>Phone</th>
            <th>Applied</th>
            <th>Status</th>
            <th class="text-end" style="min-width: 140px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% for (const owner of owners) { %>
            <%
              const isApproved = owner.status === 'approved';
              const isRejected = owner.status === 'rejected';
              const isPending  = owner.status === 'pending';
              const isInfoRequested = owner.status === 'info_requested';

              const statusClass = {
                pending:        'wl-pill-pending',
                approved:       'wl-pill-approved',
                rejected:       'wl-pill-rejected',
                info_requested: 'wl-pill-warning',
              }[owner.status] || 'wl-pill-pending';

              const statusText = {
                pending:        'Pending',
                approved:       'Approved',
                rejected:       'Not approved',
                info_requested: 'Info requested',
              }[owner.status] || owner.status;

              const appliedDate = owner.createdAt
                ? new Date(owner.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
                : "N/A";

              const bizType = (typeof BUSINESS_TYPES !== 'undefined' && BUSINESS_TYPES[owner.businessType]) || owner.businessType || 'Owner';
            %>
            <tr>
              <!-- Owner Column with Avatar -->
              <td>
                <div class="d-flex align-items-center gap-3">
                  <div
                    class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold"
                    style="width: 38px; height: 38px; background-color: var(--wl-teal-500); font-size: 0.95rem; flex-shrink: 0;"
                  >
                    <%= owner.username ? owner.username.charAt(0).toUpperCase() : 'O' %>
                  </div>
                  <div>
                    <div class="fw-bold text-dark"><%= owner.username %></div>
                    <div class="text-muted small"><%= owner.email %></div>
                  </div>
                </div>
              </td>

              <!-- Business Name -->
              <td>
                <span class="fw-medium text-dark"><%= owner.businessName %></span>
                <div class="mt-1">
                  <% if (owner.documents && owner.documents.length > 0) { %>
                    <button
                      type="button"
                      class="btn btn-link btn-sm p-0 text-decoration-none text-teal-600 fw-semibold"
                      style="font-size: 0.78rem;"
                      data-bs-toggle="modal"
                      data-bs-target="#docsModal-<%= owner.userId %>"
                    >
                      <i class="fa-solid fa-paperclip me-1"></i>View documents (<%= owner.documents.length %>)
                    </button>
                  <% } else { %>
                    <span class="text-muted" style="font-size: 0.78rem;">No documents submitted</span>
                  <% } %>
                </div>
              </td>

              <!-- Business Type -->
              <td>
                <span class="text-muted small"><%= bizType %></span>
              </td>

              <!-- Phone -->
              <td>
                <span class="text-muted small"><%= owner.phone || 'N/A' %></span>
              </td>

              <!-- Applied Date -->
              <td>
                <span class="text-muted small"><%= appliedDate %></span>
              </td>

              <!-- Status Pill + Reason -->
              <td>
                <span class="wl-pill <%= statusClass %>">
                  <span class="wl-pill-dot"></span>
                  <%= statusText %>
                </span>
                <% if (isRejected && owner.rejectionReason) { %>
                  <div class="text-muted mt-1" style="font-size: 0.76rem; max-width: 180px;">
                    <%= owner.rejectionReason %>
                  </div>
                <% } %>
                <% if (isInfoRequested && owner.verificationNote) { %>
                  <div class="text-muted mt-1" style="font-size: 0.76rem; max-width: 180px;">
                    <strong class="text-dark">Admin note:</strong> <%= owner.verificationNote %>
                  </div>
                <% } %>
              </td>

              <!-- Contextual Actions -->
              <td class="text-end">
                <div class="d-inline-flex align-items-center justify-content-end gap-2">
                  <% if (isPending || isRejected || isInfoRequested) { %>
                    <form
                      action="/admin/owners/<%= owner.userId %>/approve"
                      method="POST"
                      class="d-inline"
                    >
                      <input type="hidden" name="filter" value="<%= filter %>" />
                      <button type="submit" class="btn wl-btn-primary btn-sm px-3">
                        Approve
                      </button>
                    </form>
                  <% } %>

                  <% if (isPending || isInfoRequested) { %>
                    <!-- Request More Info Button (opens modal) -->
                    <button
                      type="button"
                      class="btn wl-btn-outline btn-sm px-3"
                      data-bs-toggle="modal"
                      data-bs-target="#adminRequestInfoModal-<%= owner.userId %>"
                    >
                      Request Info
                    </button>

                    <!-- Request Info Modal -->
                    <div
                      class="modal fade text-start"
                      id="adminRequestInfoModal-<%= owner.userId %>"
                      tabindex="-1"
                      aria-labelledby="adminRequestInfoModalLabel-<%= owner.userId %>"
                      aria-hidden="true"
                    >
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--wl-radius-lg);">
                          <form
                            action="/admin/owners/<%= owner.userId %>/request-info"
                            method="POST"
                          >
                            <input type="hidden" name="filter" value="<%= filter %>" />
                            <div class="modal-header border-bottom">
                              <h5 class="modal-title fw-bold text-dark" id="adminRequestInfoModalLabel-<%= owner.userId %>">
                                Request More Information
                              </h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                              <p class="text-muted small mb-3">
                                Ask <strong><%= owner.username %></strong> (<%= owner.businessName %>) for additional information or documents.
                              </p>
                              <label for="admin-info-msg-<%= owner.userId %>" class="form-label small fw-semibold text-dark">
                                What additional information or documents are needed? <span class="text-danger">*</span>
                              </label>
                              <textarea
                                id="admin-info-msg-<%= owner.userId %>"
                                name="message"
                                class="form-control"
                                rows="4"
                                placeholder="e.g. Please provide a clear copy of your business licence..."
                                minlength="10"
                                maxlength="500"
                                required
                              ><%= owner.verificationNote || '' %></textarea>
                              <div class="form-text text-muted small mt-1">10 to 500 characters.</div>
                            </div>
                            <div class="modal-footer border-top bg-light">
                              <button type="button" class="btn wl-btn-outline btn-sm" data-bs-dismiss="modal">
                                Cancel
                              </button>
                              <button type="submit" class="btn wl-btn-primary btn-sm px-4">
                                Send Request
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% } %>

                  <% if (isPending || isApproved || isInfoRequested) { %>
                    <button
                      type="button"
                      class="btn wl-btn-outline-danger btn-sm px-3"
                      data-bs-toggle="modal"
                      data-bs-target="#adminRejectModal-<%= owner.userId %>"
                    >
                      Reject
                    </button>

                    <!-- Rejection Reason Modal -->
                    <div
                      class="modal fade text-start"
                      id="adminRejectModal-<%= owner.userId %>"
                      tabindex="-1"
                      aria-labelledby="adminRejectModalLabel-<%= owner.userId %>"
                      aria-hidden="true"
                    >
                      <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--wl-radius-lg);">
                          <form
                            action="/admin/owners/<%= owner.userId %>/reject"
                            method="POST"
                          >
                            <input type="hidden" name="filter" value="<%= filter %>" />
                            <div class="modal-header border-bottom">
                              <h5 class="modal-title fw-bold text-dark" id="adminRejectModalLabel-<%= owner.userId %>">
                                Reject Application
                              </h5>
                              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                              <p class="text-muted small mb-3">
                                Reject application for <strong><%= owner.username %></strong> (<%= owner.businessName %>). You can optionally provide feedback.
                              </p>
                              <label for="admin-reason-<%= owner.userId %>" class="form-label small fw-semibold text-dark">
                                Reason for rejection (optional)
                              </label>
                              <textarea
                                id="admin-reason-<%= owner.userId %>"
                                name="reason"
                                class="form-control"
                                rows="3"
                                placeholder="e.g. Incomplete business documentation or test account..."
                                maxlength="500"
                              ></textarea>
                            </div>
                            <div class="modal-footer border-top bg-light">
                              <button type="button" class="btn wl-btn-outline btn-sm" data-bs-dismiss="modal">
                                Cancel
                              </button>
                              <button type="submit" class="btn wl-btn-primary btn-sm px-4">
                                Confirm Reject
                              </button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  <% } %>

                  <!-- Documents Modal -->
                  <div
                    class="modal fade text-start"
                    id="docsModal-<%= owner.userId %>"
                    tabindex="-1"
                    aria-labelledby="docsModalLabel-<%= owner.userId %>"
                    aria-hidden="true"
                  >
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                      <div class="modal-content border-0 shadow-lg" style="border-radius: var(--wl-radius-lg);">
                        <div class="modal-header border-bottom">
                          <h5 class="modal-title fw-bold text-dark" id="docsModalLabel-<%= owner.userId %>">
                            Verification Documents &middot; <%= owner.businessName %>
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4">
                          <div class="text-muted small mb-3">
                            Submitted by <strong><%= owner.username %></strong> (<%= owner.email %>)
                          </div>
                          <% if (!owner.documents || owner.documents.length === 0) { %>
                            <div class="alert alert-light border text-muted small mb-0">
                              No documents submitted
                            </div>
                          <% } else { %>
                            <div class="d-flex flex-column gap-2">
                              <% for (const doc of owner.documents) { %>
                                <%
                                  const isPdf = (doc.mimeType === 'application/pdf') || /\.pdf$/i.test(doc.originalName || '') || (doc.resourceType === 'raw');
                                  const docSize = doc.size ? ((doc.size / (1024 * 1024)).toFixed(2) + ' MB') : 'Unknown size';
                                  const docDate = doc.uploadedAt ? new Date(doc.uploadedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
                                %>
                                <div class="d-flex align-items-center justify-content-between p-3 border rounded-3 bg-white">
                                  <div class="d-flex align-items-center gap-3">
                                    <% if (isPdf) { %>
                                      <div class="rounded d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width: 44px; height: 44px; font-size: 1.4rem; flex-shrink: 0;">
                                        <i class="fa-regular fa-file-pdf"></i>
                                      </div>
                                    <% } else { %>
                                      <a href="<%= doc.url %>" target="_blank" rel="noopener noreferrer">
                                        <img src="<%= doc.url %>" alt="<%= doc.originalName || 'Document' %>" class="rounded border" style="width: 44px; height: 44px; object-fit: cover; flex-shrink: 0;" />
                                      </a>
                                    <% } %>
                                    <div>
                                      <div class="fw-semibold text-dark text-break"><%= doc.originalName || 'Verification Document' %></div>
                                      <div class="text-muted small">
                                        <%= docSize %><% if (docDate) { %> &middot; Uploaded <%= docDate %><% } %>
                                      </div>
                                    </div>
                                  </div>
                                  <div>
                                    <a href="<%= doc.url %>" target="_blank" rel="noopener noreferrer" class="btn wl-btn-outline btn-sm px-3">
                                      Open <i class="fa-solid fa-arrow-up-right-from-square ms-1" style="font-size: 0.75rem;"></i>
                                    </a>
                                  </div>
                                </div>
                              <% } %>
                            </div>
                          <% } %>
                        </div>
                        <div class="modal-footer border-top bg-light">
                          <button type="button" class="btn wl-btn-primary btn-sm px-4" data-bs-dismiss="modal">
                            Close
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
