<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WanderLust Mock Payment Gateway - Test Mode</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />
  <style>
    body {
      background-color: #0f172a;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2rem 1rem;
    }
    .gateway-card {
      background: #ffffff;
      border-radius: 1rem;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
      max-width: 620px;
      margin: 0 auto;
      overflow: hidden;
    }
    .test-mode-banner {
      background: #f59e0b;
      color: #78350f;
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .nav-pills .nav-link {
      color: #475569;
      font-weight: 600;
      border-radius: 0.5rem;
      padding: 0.6rem 1rem;
    }
    .nav-pills .nav-link.active {
      background-color: #0284c7;
      color: #ffffff;
    }
  </style>
</head>
<body>
  <div class="gateway-card">
    <!-- Test Mode Warning Banner -->
    <div class="test-mode-banner">
      <span><i class="fa-solid fa-flask-vial me-2"></i>Mock Payment Gateway (Test Mode)</span>
      <span class="badge bg-dark text-warning">SIMULATOR</span>
    </div>

    <!-- Header & Order Amount -->
    <div class="p-4 bg-light border-bottom d-flex align-items-center justify-content-between">
      <div>
        <div class="d-flex align-items-center gap-2">
          <i class="fa-solid fa-shield-halved text-primary fs-4"></i>
          <h5 class="fw-bold text-dark mb-0">WanderLust SecurePay</h5>
        </div>
        <div class="text-muted small mt-1">Order Ref: <code><%= order.orderId %></code></div>
      </div>
      <div class="text-end">
        <div class="text-muted small">Amount to Pay</div>
        <div class="h3 fw-bold text-dark mb-0">&#8377;<%= Number(order.amount).toLocaleString("en-IN") %></div>
        <span class="badge bg-info text-dark text-uppercase" style="font-size: 0.7rem;"><%= order.purpose %> Payment</span>
      </div>
    </div>

    <div class="p-4">
      <!-- Test Credentials Accordion / Helper -->
      <div class="alert alert-secondary p-3 rounded-3 mb-4 small">
        <div class="d-flex align-items-center justify-content-between cursor-pointer" data-bs-toggle="collapse" data-bs-target="#testCredentialsCollapse">
          <span class="fw-bold text-dark"><i class="fa-solid fa-circle-question me-1 text-primary"></i>View Test Credentials & Simulation Outcomes</span>
          <i class="fa-solid fa-chevron-down text-muted"></i>
        </div>
        <div class="collapse show mt-2 pt-2 border-top" id="testCredentialsCollapse">
          <table class="table table-sm table-borderless mb-0" style="font-size: 0.75rem;">
            <tbody>
              <tr>
                <td class="fw-bold" style="width: 100px;">Card (Success):</td>
                <td><code>4111 1111 1111 1111</code> (OTP: <code>123456</code>)</td>
              </tr>
              <tr>
                <td class="fw-bold">Card (Decline):</td>
                <td><code>4000 0000 0000 0002</code></td>
              </tr>
              <tr>
                <td class="fw-bold">Card (Low Fund):</td>
                <td><code>4000 0000 0000 9995</code></td>
              </tr>
              <tr>
                <td class="fw-bold">UPI (Success):</td>
                <td><code>success@mock</code></td>
              </tr>
              <tr>
                <td class="fw-bold">UPI (Fail):</td>
                <td><code>fail@mock</code></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Payment Method Tabs -->
      <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-3" id="paymentTabs" role="tablist">
        <li class="nav-item">
          <button class="nav-link active" id="card-tab" data-bs-toggle="pill" data-bs-target="#cardTabPane" type="button">
            <i class="fa-solid fa-credit-card me-1"></i>Credit / Debit Card
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" id="upi-tab" data-bs-toggle="pill" data-bs-target="#upiTabPane" type="button">
            <i class="fa-solid fa-mobile-screen me-1"></i>UPI / QR
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" id="netbanking-tab" data-bs-toggle="pill" data-bs-target="#netbankingTabPane" type="button">
            <i class="fa-solid fa-building-columns me-1"></i>Net Banking
          </button>
        </li>
      </ul>

      <!-- Tab Content Forms -->
      <form id="gatewayForm" action="/mock-gateway/checkout/<%= order.orderId %>" method="POST">
        <div class="tab-content">
          <!-- 1. Card Tab -->
          <div class="tab-pane fade show active" id="cardTabPane">
            <input type="hidden" name="method" id="selectedMethod" value="card" />

            <div class="mb-3">
              <label class="form-label small fw-bold text-dark">Card Number</label>
              <div class="input-group">
                <input
                  type="text"
                  name="cardNumber"
                  id="cardNumberInput"
                  class="form-control"
                  placeholder="4111 1111 1111 1111"
                  value="4111 1111 1111 1111"
                  maxlength="19"
                />
                <span class="input-group-text bg-white" id="cardBrandIcon">
                  <i class="fa-brands fa-cc-visa fs-5 text-primary"></i>
                </span>
              </div>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6">
                <label class="form-label small fw-bold text-dark">Expiry (MM/YY)</label>
                <input
                  type="text"
                  name="cardExpiry"
                  class="form-control"
                  placeholder="12/28"
                  value="12/28"
                  maxlength="5"
                />
              </div>
              <div class="col-6">
                <label class="form-label small fw-bold text-dark">CVV</label>
                <input
                  type="password"
                  name="cardCvv"
                  class="form-control"
                  placeholder="123"
                  value="123"
                  maxlength="4"
                />
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold text-dark">Cardholder Name</label>
              <input
                type="text"
                name="cardHolder"
                class="form-control"
                placeholder="Name on card"
                value="<%= booking ? booking.customer_username : 'Test User' %>"
              />
            </div>

            <div class="p-3 bg-light rounded-3 border mb-3">
              <label class="form-label small fw-bold text-dark mb-1">
                <i class="fa-solid fa-key me-1 text-warning"></i>Bank SMS OTP Verification
              </label>
              <input
                type="text"
                name="otp"
                class="form-control text-center fs-5 fw-bold font-monospace"
                placeholder="123456"
                value="123456"
                maxlength="6"
              />
              <div class="form-text text-center">Enter <code>123456</code> for simulated successful bank auth.</div>
            </div>
          </div>

          <!-- 2. UPI Tab -->
          <div class="tab-pane fade" id="upiTabPane">
            <div class="mb-3">
              <label class="form-label small fw-bold text-dark">Enter Virtual Payment Address (UPI ID)</label>
              <input
                type="text"
                name="upiId"
                id="upiIdInput"
                class="form-control"
                placeholder="username@bank"
                value="success@mock"
              />
              <div class="form-text">
                Use <code>success@mock</code> for approval, or <code>fail@mock</code> for decline.
              </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-4">
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setUpi('success@mock')">success@mock (Pass)</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" onclick="setUpi('fail@mock')">fail@mock (Fail)</button>
            </div>
          </div>

          <!-- 3. Netbanking Tab -->
          <div class="tab-pane fade" id="netbankingTabPane">
            <div class="mb-3">
              <label class="form-label small fw-bold text-dark">Select Your Bank</label>
              <select name="bankName" class="form-select">
                <option value="HDFC Bank" selected>HDFC Bank</option>
                <option value="State Bank of India">State Bank of India</option>
                <option value="ICICI Bank">ICICI Bank</option>
                <option value="Axis Bank">Axis Bank</option>
                <option value="Kotak Mahindra Bank">Kotak Mahindra Bank</option>
              </select>
            </div>

            <div class="mb-4">
              <label class="form-label small fw-bold text-dark">Simulate Bank Authorization Result</label>
              <div class="d-flex gap-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="bankOutcome" id="bankPass" value="success" checked />
                  <label class="form-check-label text-success fw-semibold" for="bankPass">Authorize (Pass)</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="bankOutcome" id="bankFail" value="fail" />
                  <label class="form-check-label text-danger fw-semibold" for="bankFail">Decline (Fail)</label>
                </div>
              </div>
            </div>
          </div>
        </div>

        <button type="submit" id="paySubmitBtn" class="btn btn-primary w-100 py-3 fw-bold fs-6 shadow">
          <i class="fa-solid fa-lock me-2"></i>Pay &#8377;<%= Number(order.amount).toLocaleString("en-IN") %>
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="p-3 bg-light text-center text-muted small border-top" style="font-size: 0.75rem;">
      <i class="fa-solid fa-lock me-1"></i>256-Bit SSL Encrypted Mock Simulator &middot; Card details are never persisted
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const methodInput = document.getElementById("selectedMethod");
    document.getElementById("card-tab").addEventListener("click", () => methodInput.value = "card");
    document.getElementById("upi-tab").addEventListener("click", () => methodInput.value = "upi");
    document.getElementById("netbanking-tab").addEventListener("click", () => methodInput.value = "netbanking");

    function setUpi(val) {
      document.getElementById("upiIdInput").value = val;
    }

    const form = document.getElementById("gatewayForm");
    const btn = document.getElementById("paySubmitBtn");
    form.addEventListener("submit", () => {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Simulating Bank Authorization...';
    });
  </script>
</body>
</html>
