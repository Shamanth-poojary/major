<% layout("layouts/boilerplate") -%>

<div class="wl-container py-4 py-md-5">
  <!-- Breadcrumbs & Actions -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="wl-breadcrumb m-0">
      <a href="/listings" class="text-muted text-decoration-none">Listings</a>
      <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
      <span class="text-dark fw-semibold text-truncate" style="max-width: 280px;"><%= listing.title %></span>
    </div>

    <!-- Wishlist Button -->
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <button
        type="button"
        id="showWishlistBtn"
        class="btn wl-btn-outline d-inline-flex align-items-center gap-2 py-2 px-3"
        onclick="toggleShowWishlist('<%= listing.id %>', this)"
      >
        <i class="<%= typeof isWishlisted !== 'undefined' && isWishlisted ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
        <span id="wishlistText"><%= typeof isWishlisted !== 'undefined' && isWishlisted ? 'Saved in Wishlist' : 'Add to Wishlist' %></span>
      </button>
    <% } else { %>
      <a href="/login" class="btn wl-btn-outline d-inline-flex align-items-center gap-2 py-2 px-3">
        <i class="fa-regular fa-heart"></i>
        <span>Login to save</span>
      </a>
    <% } %>
  </div>

  <!-- Title & Location Header -->
  <div class="mb-4">
    <h1 class="h2 fw-bold text-dark mb-2"><%= listing.title %></h1>
    <div class="d-flex align-items-center gap-2 text-muted small">
      <i class="fa-solid fa-location-dot text-muted"></i>
      <span><%= listing.location %>, <%= listing.country %></span>
      <span>&middot;</span>
      <span>Hosted by <strong><%= listing.owner ? listing.owner.username : 'WanderLust Host' %></strong></span>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="mb-4 overflow-hidden rounded-4 shadow-sm border" style="max-height: 480px; background-color: #EBF0F2;">
    <img
      src="<%= listing.image.url %>"
      class="w-100 h-100"
      alt="<%= listing.title %>"
      style="object-fit: cover; max-height: 480px;"
    />
  </div>

  <!-- Content Grid: Left Details & Right Booking/Price Card -->
  <div class="row g-4 mb-5">
    <!-- Left: Description & Host Info -->
    <div class="col-12 col-lg-8">
      <div class="wl-card p-4 mb-4">
        <h2 class="h5 fw-bold text-dark mb-3">About this space</h2>
        <p class="text-secondary" style="line-height: 1.7; white-space: pre-line;">
          <%= listing.description %>
        </p>

        <hr class="my-4" />

        <div class="row g-3 text-muted small">
          <div class="col-6 col-md-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-shield-halved text-teal-600 fs-5"></i>
            <div>
              <div class="fw-bold text-dark">Verified Space</div>
              <div>Inspected by WanderLust</div>
            </div>
          </div>
          <div class="col-6 col-md-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-clock text-teal-600 fs-5"></i>
            <div>
              <div class="fw-bold text-dark">Flexible Check-in</div>
              <div>Self check-in available</div>
            </div>
          </div>
          <div class="col-6 col-md-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-medal text-teal-600 fs-5"></i>
            <div>
              <div class="fw-bold text-dark">Top Hospitality</div>
              <div>Dedicated host care</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Owner Actions (Edit / Delete / Rooms) -->
      <% if (typeof currentUser !== 'undefined' && currentUser &&
          typeof canManageListings !== 'undefined' && canManageListings &&
          listing.owner && currentUser.id === listing.owner.id) { %>
        <div class="wl-card p-3 mb-4 bg-light border d-flex align-items-center justify-content-between flex-wrap gap-2">
          <span class="small fw-semibold text-dark">
            <i class="fa-solid fa-gear me-1 text-muted"></i>Host Management Tools
          </span>
          <div class="d-flex flex-wrap gap-2">
            <a href="/owner/listings/<%= listing.id %>/rooms" class="btn btn-sm btn-primary px-3">
              <i class="fa-solid fa-bed me-1"></i>Manage Rooms & Pricing
            </a>
            <a href="/listings/<%= listing.id %>/edit" class="btn wl-btn-outline btn-sm px-3">
              <i class="fa-solid fa-pencil me-1"></i>Edit Listing
            </a>
            <form
              id="deleteForm-<%= listing.id %>"
              method="POST"
              action="/listings/<%= listing.id %>?_method=DELETE"
              class="d-inline"
            >
              <button
                type="button"
                class="btn wl-btn-outline-danger btn-sm px-3"
                onclick="confirmDelete('<%= listing.id %>')"
              >
                <i class="fa-solid fa-trash me-1"></i>Delete
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Available Rooms & Suites Section -->
      <% if (typeof rooms !== 'undefined' && rooms && rooms.length > 0) { %>
        <div class="wl-card p-4 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h5 fw-bold text-dark mb-0">
              <i class="fa-solid fa-door-open me-2 text-primary"></i>Available Rooms & Spaces
            </h2>
            <span class="badge bg-light text-dark border px-2 py-1"><%= rooms.length %> Options</span>
          </div>
          <div class="row g-3">
            <% for (let room of rooms) { %>
              <div class="col-12">
                <div class="card border rounded-3 p-3 h-100 hover-shadow transition">
                  <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-3">
                      <img
                        src="<%= room.image_url || listing.image.url %>"
                        alt="<%= room.name %>"
                        class="rounded-3 w-100"
                        style="height: 120px; object-fit: cover;"
                      />
                    </div>
                    <div class="col-12 col-md-6">
                      <div class="d-flex align-items-center gap-2 mb-1">
                        <h5 class="fw-bold text-dark mb-0"><%= room.name %></h5>
                        <span class="badge bg-secondary text-uppercase" style="font-size: 0.65rem;"><%= room.category %></span>
                      </div>
                      <p class="text-muted small mb-2 text-truncate" style="max-width: 400px;">
                        <%= room.description || 'Modern and welcoming space with tailored amenities.' %>
                      </p>
                      <div class="d-flex flex-wrap gap-2 text-muted small">
                        <span><i class="fa-solid fa-user-group me-1"></i>Up to <%= room.max_guests %> guests</span>
                        <% if (room.bed_config) { %>
                          <span>&middot;</span>
                          <span><i class="fa-solid fa-bed me-1"></i><%= room.bed_config %></span>
                        <% } %>
                        <% if (room.size_sqft) { %>
                          <span>&middot;</span>
                          <span><i class="fa-solid fa-ruler-combined me-1"></i><%= room.size_sqft %> sq ft</span>
                        <% } %>
                      </div>
                      <% if (room.amenities && room.amenities.length > 0) { %>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                          <% for (let a of room.amenities.slice(0, 3)) { %>
                            <span class="badge bg-light text-dark border" style="font-size: 0.7rem;"><%= a %></span>
                          <% } %>
                          <% if (room.amenities.length > 3) { %>
                            <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">+<%= room.amenities.length - 3 %> more</span>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                    <div class="col-12 col-md-3 text-md-end border-start-md pt-2 pt-md-0">
                      <div class="text-muted small">From</div>
                      <div class="h4 fw-bold text-dark mb-2">&#8377;<%= room.price_per_night.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">/ night</span></div>
                      <a href="/listings/<%= listing.id %>/book" class="btn btn-outline-primary btn-sm w-100">
                        Select
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      <% } %>

      <!-- Map Section -->
      <div class="wl-card p-4 mb-4">
        <h2 class="h5 fw-bold text-dark mb-2">Where you'll be</h2>
        <p class="text-muted small mb-3">
          <i class="fa-solid fa-location-dot me-1 text-muted"></i><%= listing.location %>, <%= listing.country %>
        </p>

        <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
          <script>
            let mapToken = "<%= process.env.MAP_TOKEN %>";
            const coordinates = JSON.parse('<%- JSON.stringify(listing.geometry.coordinates) %>');
          </script>

          <button id="loadMapBtn" class="btn wl-btn-teal btn-sm mb-3">
            <i class="fa-solid fa-map-location-dot me-1"></i>Load Interactive Map
          </button>

          <div
            id="map"
            data-token="<%= process.env.MAP_TOKEN %>"
            data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
            style="display: none; height: 360px; width: 100%; border-radius: var(--wl-radius-md);"
          ></div>
        <% } else { %>
          <div class="alert alert-secondary mb-0 border-0">
            📍 No map added yet for this listing.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right: Booking & Pricing Card -->
    <div class="col-12 col-lg-4">
      <div class="wl-card p-4 sticky-top shadow-sm" style="top: 88px; z-index: 20;">
        <div class="d-flex align-items-baseline gap-1 mb-3">
          <span class="display-6 fw-bold text-dark">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          <span class="text-muted small">/ night</span>
        </div>

        <!-- Interactive Booking Widget -->
        <form action="/listings/<%= listing.id %>/book" method="GET" class="mb-3">
          <div class="border rounded-3 overflow-hidden mb-3">
            <div class="row g-0 border-bottom">
              <div class="col-6 p-2 border-end">
                <label class="form-label text-uppercase text-muted fw-bold mb-0" style="font-size: 0.65rem;">Check-In</label>
                <input
                  type="date"
                  name="checkIn"
                  id="showCheckIn"
                  class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold"
                  required
                />
              </div>
              <div class="col-6 p-2">
                <label class="form-label text-uppercase text-muted fw-bold mb-0" style="font-size: 0.65rem;">Check-Out</label>
                <input
                  type="date"
                  name="checkOut"
                  id="showCheckOut"
                  class="form-control form-control-sm border-0 p-0 shadow-none fw-semibold"
                  required
                />
              </div>
            </div>
            <div class="p-2">
              <label class="form-label text-uppercase text-muted fw-bold mb-0" style="font-size: 0.65rem;">Guests</label>
              <select name="adults" class="form-select form-select-sm border-0 p-0 shadow-none fw-semibold">
                <option value="1">1 Adult</option>
                <option value="2" selected>2 Adults</option>
                <option value="3">3 Adults</option>
                <option value="4">4 Adults</option>
                <option value="6">6+ Guests</option>
              </select>
            </div>
          </div>

          <% if (typeof currentUser !== 'undefined' && currentUser && listing.owner && currentUser.id === listing.owner.id) { %>
            <div class="alert alert-info py-2 px-3 small mb-3">
              <i class="fa-solid fa-circle-info me-1"></i>You own this listing.
            </div>
            <a href="/owner/listings/<%= listing.id %>/rooms" class="btn btn-outline-primary w-100 py-2 mb-2">
              <i class="fa-solid fa-sliders me-1"></i>Manage Room Inventory
            </a>
          <% } else { %>
            <button type="submit" class="btn wl-btn-primary w-100 py-3 mb-2 text-center fw-bold shadow-sm">
              <i class="fa-solid fa-calendar-check me-2"></i>Reserve Now
            </button>
            <div class="text-center text-muted small" style="font-size: 0.78rem;">
              You won't be charged yet &middot; Instant confirmation
            </div>
          <% } %>
        </form>

        <div class="p-3 rounded-3 bg-light border small">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Starting rate</span>
            <span class="fw-semibold text-dark">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Cleaning & service</span>
            <span class="text-success fw-medium">Included</span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Advance booking</span>
            <span class="text-dark fw-medium">Available (25%)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="wl-card p-4 mb-4">
    <h2 class="h4 fw-bold text-dark mb-4">
      <i class="fa-regular fa-star me-2 text-warning"></i>Guest Reviews
      <span class="text-muted fs-6 fw-normal ms-1">(<%= listing.reviews.length %>)</span>
    </h2>

    <% if (listing.reviews.length === 0) { %>
      <div class="text-muted py-3">No reviews yet. Be the first to share your experience!</div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
        <% for (let review of listing.reviews) { %>
          <% if (review) { %>
            <div class="col">
              <div class="p-3 rounded-3 bg-light border h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-bold text-dark"><%= review.owner ? review.owner.username : 'Guest' %></div>
                    <small class="text-muted" style="font-size: 0.75rem;">
                      <%= review.createdAt instanceof Date ? review.createdAt.toDateString() : new Date(review.createdAt).toDateString() %>
                    </small>
                  </div>
                  <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                    Rated: <%= review.rating %> stars
                  </p>
                  <p class="text-secondary small mb-2"><%= review.comment %></p>
                </div>

                <% if (typeof currentUser !== 'undefined' && currentUser && review.owner && currentUser.id === review.owner.id) { %>
                  <form
                    method="POST"
                    action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE"
                    id="deleteForm-<%= review.id %>"
                    class="text-end mt-2"
                  >
                    <button
                      class="btn btn-sm text-danger p-0 border-0 bg-transparent small"
                      onclick="confirmDelete('<%= review.id %>')"
                      type="button"
                    >
                      <i class="fa-regular fa-trash-can me-1"></i>Delete review
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>
    <% } %>

    <!-- Add Review Form (Logged In) -->
    <div class="pt-4 border-top">
      <h3 class="h5 fw-bold text-dark mb-3">Leave a Review</h3>

      <% if (typeof errors !== 'undefined' && errors && Object.keys(errors).length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% for (const [field, msg] of Object.entries(errors)) { %>
              <li><%= msg %></li>
            <% } %>
          </ul>
        </div>
      <% } %>

      <form
        action="/listings/<%= listing.id %>/reviews"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label class="form-label d-block small fw-bold text-dark">Rating</label>
          <fieldset class="starability-coinFlip">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" checked />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-bold text-dark">Your Comment</label>
          <textarea
            name="review[comment]"
            class="form-control"
            rows="3"
            placeholder="Share your stay experience, tips for future travelers, or highlights..."
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a comment.</div>
        </div>

        <button class="btn wl-btn-primary px-4" type="submit">
          Submit Review
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Scripts for Delete & Wishlist -->
<script>
  function confirmDelete(id) {
    if (confirm("Are you sure you want to delete this item?")) {
      document.getElementById("deleteForm-" + id).submit();
    }
  }

  async function toggleShowWishlist(listingId, btn) {
    const icon = btn.querySelector("i");
    const textSpan = document.getElementById("wishlistText");
    const isSaved = icon.classList.contains("fa-solid");
    const method = isSaved ? "DELETE" : "POST";

    try {
      const res = await fetch(`/wishlist/${listingId}`, {
        method: method,
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
        },
      });

      if (res.status === 401) {
        window.location.href = "/login";
        return;
      }

      const data = await res.json();
      if (data && data.success) {
        if (data.wishlisted) {
          icon.classList.remove("fa-regular");
          icon.classList.add("fa-solid", "text-danger");
          textSpan.textContent = "Saved in Wishlist";
        } else {
          icon.classList.remove("fa-solid", "text-danger");
          icon.classList.add("fa-regular");
          textSpan.textContent = "Add to Wishlist";
        }
      }
    } catch (err) {
      console.error("Error toggling wishlist:", err);
    }
  }

  // Set default check-in & check-out dates
  document.addEventListener("DOMContentLoaded", () => {
    const inEl = document.getElementById("showCheckIn");
    const outEl = document.getElementById("showCheckOut");
    if (inEl && outEl && !inEl.value) {
      const today = new Date();
      const tomorrow = new Date(today);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const dayAfter = new Date(today);
      dayAfter.setDate(dayAfter.getDate() + 2);

      const toIsoDate = (d) => d.toISOString().split("T")[0];
      inEl.value = toIsoDate(tomorrow);
      outEl.value = toIsoDate(dayAfter);
      inEl.min = toIsoDate(today);
      outEl.min = toIsoDate(tomorrow);

      inEl.addEventListener("change", () => {
        if (inEl.value) {
          const nextDay = new Date(inEl.value);
          nextDay.setDate(nextDay.getDate() + 1);
          outEl.min = toIsoDate(nextDay);
          if (outEl.value <= inEl.value) {
            outEl.value = toIsoDate(nextDay);
          }
        }
      });
    }
  });
</script>