<% layout("layouts/boilerplate") -%>

<body>
  <!-- LISTING TITLE -->
  <h3 class="mt-3">
    <p class="card-text offset-2">
      <b><%= listing.title %></b>
    </p>
  </h3>

  <!-- LISTING CARD -->
  <div class="card offset-2 mt-2 listing-card" style="width: 18rem">
    <img
      src="<%= listing.image %>"
      class="card-img-top show-img"
      alt="listing image"
    />

    <div class="card-body">
      <p><%= listing.description %></p>

      <ul class="list-unstyled">
        <li>₹ <%= listing.price.toLocaleString("en-IN") %></li>
        <li><%= listing.country %></li>
        <li><%= listing.location %></li>
      </ul>
    </div>
  </div>

  <!-- EDIT / DELETE BUTTONS -->
  <div class="row mt-3">
    <div class="col-auto offset-2">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
        Edit
      </a>
    </div>

    <div class="col-auto">
      <form
        id="deleteForm-<%= listing._id %>"
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button
          type="button"
          class="btn btn-danger"
          onclick="confirmDelete('<%= listing._id %>')"
        >
          Delete
        </button>
      </form>
    </div>
  </div>

  <!-- ADD REVIEW FORM -->
  <div class="row mt-4">
    <div class="col-6 offset-2">
      <h4>Leave a Review</h4>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <!-- RATING SLIDER -->
        <div class="mb-3">
          <label class="form-label">Rating</label>
          <input
            type="range"
            min="0"
            max="5"
            step="1"
            value="0"
            id="rating"
            name="review[rating]"
            class="form-range"
            required
          />
          <div class="invalid-feedback">
            Please choose a rating between 1 and 5.
          </div>
        </div>

        <!-- COMMENT -->
        <div class="mb-3">
          <label class="form-label">Comment</label>
          <textarea
            name="review[comment]"
            class="form-control"
            rows="4"
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a comment.</div>
        </div>

        <button class="btn btn-primary">Submit</button>
      </form>
    </div>
  </div>

  <hr />

  <!-- REVIEWS SECTION -->
  <div class="row mt-4">
    <div class="col-8 offset-2">
      <h4>Reviews</h4>

      <% if (listing.reviews.length === 0) { %>
      <p>No reviews yet. Be the first to review!</p>
      <% } else { %>

      <div class="row">
        <% for (let review of listing.reviews) { %> <% if (review) { %>

        <div class="card col-5 mb-3 ms-3">
          <div class="card-body">
            <h6 class="card-title">John</h6>

            <p class="card-text"><%= review.comment %></p>

            <!-- STAR RATING -->
            <div class="rating text-warning fs-5 mb-1">
              <% for (let i = 1; i <= 5; i++) { %> <%= i <= review.rating ? "★"
              : "☆" %> <% } %>
            </div>

            <small class="text-muted">
              Reviewed on <%= review.createdAt.toDateString() %>
            </small>
          </div>
        </div>

        <% } %> <% } %>
      </div>

      <% } %>
    </div>
  </div>

  <!-- DELETE CONFIRMATION -->
  <script>
    function confirmDelete(id) {
      if (confirm("Are you sure you want to delete this listing?")) {
        document.getElementById("deleteForm-" + id).submit();
      }
    }
  </script>
</body>
