<% layout("layouts/boilerplate") -%>

<div class="wl-container py-4 py-md-5">
  <!-- Breadcrumbs & Actions -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="wl-breadcrumb m-0">
      <a href="/listings" class="text-muted text-decoration-none">Listings</a>
      <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
      <span class="text-dark fw-semibold text-truncate" style="max-width: 280px;"><%= listing.title %></span>
    </div>

    <!-- Wishlist Button -->
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <button
        type="button"
        id="showWishlistBtn"
        class="btn wl-btn-outline d-inline-flex align-items-center gap-2 py-2 px-3"
        onclick="toggleShowWishlist('<%= listing.id %>', this)"
      >
        <i class="<%= typeof isWishlisted !== 'undefined' && isWishlisted ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
        <span id="wishlistText"><%= typeof isWishlisted !== 'undefined' && isWishlisted ? 'Saved in Wishlist' : 'Add to Wishlist' %></span>
      </button>
    <% } else { %>
      <a href="/login" class="btn wl-btn-outline d-inline-flex align-items-center gap-2 py-2 px-3">
        <i class="fa-regular fa-heart"></i>
        <span>Login to save</span>
      </a>
    <% } %>
  </div>

  <!-- Title & Location Header -->
  <div class="mb-4">
    <h1 class="h2 fw-bold text-dark mb-2"><%= listing.title %></h1>
    <div class="d-flex align-items-center gap-2 text-muted small">
      <i class="fa-solid fa-location-dot text-muted"></i>
      <span><%= listing.location %>, <%= listing.country %></span>
      <span>&middot;</span>
      <span>Hosted by <strong><%= listing.owner ? listing.owner.username : 'WanderLust Host' %></strong></span>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="mb-4 overflow-hidden rounded-4 shadow-sm border" style="max-height: 480px; background-color: #EBF0F2;">
    <img
      src="<%= listing.image.url %>"
      class="w-100 h-100"
      alt="<%= listing.title %>"
      style="object-fit: cover; max-height: 480px;"
    />
  </div>

  <!-- Content Grid: Left Details & Right Booking/Price Card -->
  <div class="row g-4 mb-5">
    <!-- Left: Description & Host Info -->
    <div class="col-12 col-lg-8">
      <div class="wl-card p-4 mb-4">
        <h2 class="h5 fw-bold text-dark mb-3">About this space</h2>
        <p class="text-secondary" style="line-height: 1.7; white-space: pre-line;">
          <%= listing.description %>
        </p>

        <hr class="my-4" />

        <div class="row g-3 text-muted small">
          <div class="col-6 col-md-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-shield-halved text-teal-600 fs-5"></i>
            <div>
              <div class="fw-bold text-dark">Verified Space</div>
              <div>Inspected by WanderLust</div>
            </div>
          </div>
          <div class="col-6 col-md-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-clock text-teal-600 fs-5"></i>
            <div>
              <div class="fw-bold text-dark">Flexible Check-in</div>
              <div>Self check-in available</div>
            </div>
          </div>
          <div class="col-6 col-md-4 d-flex align-items-center gap-2">
            <i class="fa-solid fa-medal text-teal-600 fs-5"></i>
            <div>
              <div class="fw-bold text-dark">Top Hospitality</div>
              <div>Dedicated host care</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Owner Actions (Edit / Delete) -->
      <% if (typeof currentUser !== 'undefined' && currentUser &&
          typeof canManageListings !== 'undefined' && canManageListings &&
          listing.owner && currentUser.id === listing.owner.id) { %>
        <div class="wl-card p-3 mb-4 bg-light border d-flex align-items-center justify-content-between flex-wrap gap-2">
          <span class="small fw-semibold text-dark">
            <i class="fa-solid fa-gear me-1 text-muted"></i>Host Management Tools
          </span>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing.id %>/edit" class="btn wl-btn-outline btn-sm px-3">
              <i class="fa-solid fa-pencil me-1"></i>Edit Listing
            </a>
            <form
              id="deleteForm-<%= listing.id %>"
              method="POST"
              action="/listings/<%= listing.id %>?_method=DELETE"
              class="d-inline"
            >
              <button
                type="button"
                class="btn wl-btn-outline-danger btn-sm px-3"
                onclick="confirmDelete('<%= listing.id %>')"
              >
                <i class="fa-solid fa-trash me-1"></i>Delete
              </button>
            </form>
          </div>
        </div>
      <% } %>

      <!-- Map Section -->
      <div class="wl-card p-4 mb-4">
        <h2 class="h5 fw-bold text-dark mb-2">Where you'll be</h2>
        <p class="text-muted small mb-3">
          <i class="fa-solid fa-location-dot me-1 text-muted"></i><%= listing.location %>, <%= listing.country %>
        </p>

        <% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
          <script>
            let mapToken = "<%= process.env.MAP_TOKEN %>";
            const coordinates = JSON.parse('<%- JSON.stringify(listing.geometry.coordinates) %>');
          </script>

          <button id="loadMapBtn" class="btn wl-btn-teal btn-sm mb-3">
            <i class="fa-solid fa-map-location-dot me-1"></i>Load Interactive Map
          </button>

          <div
            id="map"
            data-token="<%= process.env.MAP_TOKEN %>"
            data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
            style="display: none; height: 360px; width: 100%; border-radius: var(--wl-radius-md);"
          ></div>
        <% } else { %>
          <div class="alert alert-secondary mb-0 border-0">
            📍 No map added yet for this listing.
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right: Pricing Card -->
    <div class="col-12 col-lg-4">
      <div class="wl-card p-4 sticky-top shadow-sm" style="top: 88px;">
        <div class="d-flex align-items-baseline gap-1 mb-3">
          <span class="display-6 fw-bold text-dark">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          <span class="text-muted small">/ night</span>
        </div>

        <div class="p-3 rounded-3 bg-light border mb-4 small">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Standard rate</span>
            <span class="fw-semibold text-dark">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Cleaning & service</span>
            <span class="text-success fw-medium">Included</span>
          </div>
          <hr class="my-2" />
          <div class="d-flex justify-content-between fw-bold text-dark">
            <span>Total estimate</span>
            <span>&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          </div>
        </div>

        <a href="/listings" class="btn wl-btn-primary w-100 py-3 mb-2 text-center">
          Explore Other Stays
        </a>
        <div class="text-center text-muted small" style="font-size: 0.78rem;">
          You won't be charged yet
        </div>
      </div>
    </div>
  </div>

  <!-- Reviews Section -->
  <div class="wl-card p-4 mb-4">
    <h2 class="h4 fw-bold text-dark mb-4">
      <i class="fa-regular fa-star me-2 text-warning"></i>Guest Reviews
      <span class="text-muted fs-6 fw-normal ms-1">(<%= listing.reviews.length %>)</span>
    </h2>

    <% if (listing.reviews.length === 0) { %>
      <div class="text-muted py-3">No reviews yet. Be the first to share your experience!</div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 g-3 mb-4">
        <% for (let review of listing.reviews) { %>
          <% if (review) { %>
            <div class="col">
              <div class="p-3 rounded-3 bg-light border h-100 d-flex flex-column justify-content-between">
                <div>
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-bold text-dark"><%= review.owner ? review.owner.username : 'Guest' %></div>
                    <small class="text-muted" style="font-size: 0.75rem;">
                      <%= review.createdAt instanceof Date ? review.createdAt.toDateString() : new Date(review.createdAt).toDateString() %>
                    </small>
                  </div>
                  <p class="starability-result mb-2" data-rating="<%= review.rating %>">
                    Rated: <%= review.rating %> stars
                  </p>
                  <p class="text-secondary small mb-2"><%= review.comment %></p>
                </div>

                <% if (typeof currentUser !== 'undefined' && currentUser && review.owner && currentUser.id === review.owner.id) { %>
                  <form
                    method="POST"
                    action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE"
                    id="deleteForm-<%= review.id %>"
                    class="text-end mt-2"
                  >
                    <button
                      class="btn btn-sm text-danger p-0 border-0 bg-transparent small"
                      onclick="confirmDelete('<%= review.id %>')"
                      type="button"
                    >
                      <i class="fa-regular fa-trash-can me-1"></i>Delete review
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>
    <% } %>

    <!-- Add Review Form (Logged In) -->
    <div class="pt-4 border-top">
      <h3 class="h5 fw-bold text-dark mb-3">Leave a Review</h3>

      <% if (typeof errors !== 'undefined' && errors && Object.keys(errors).length > 0) { %>
        <div class="alert alert-danger">
          <ul class="mb-0">
            <% for (const [field, msg] of Object.entries(errors)) { %>
              <li><%= msg %></li>
            <% } %>
          </ul>
        </div>
      <% } %>

      <form
        action="/listings/<%= listing.id %>/reviews"
        method="POST"
        class="needs-validation"
        novalidate
      >
        <div class="mb-3">
          <label class="form-label d-block small fw-bold text-dark">Rating</label>
          <fieldset class="starability-coinFlip">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" checked />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-bold text-dark">Your Comment</label>
          <textarea
            name="review[comment]"
            class="form-control"
            rows="3"
            placeholder="Share your stay experience, tips for future travelers, or highlights..."
            required
          ></textarea>
          <div class="invalid-feedback">Please enter a comment.</div>
        </div>

        <button class="btn wl-btn-primary px-4" type="submit">
          Submit Review
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Scripts for Delete & Wishlist -->
<script>
  function confirmDelete(id) {
    if (confirm("Are you sure you want to delete this item?")) {
      document.getElementById("deleteForm-" + id).submit();
    }
  }

  async function toggleShowWishlist(listingId, btn) {
    const icon = btn.querySelector("i");
    const textSpan = document.getElementById("wishlistText");
    const isSaved = icon.classList.contains("fa-solid");
    const method = isSaved ? "DELETE" : "POST";

    try {
      const res = await fetch(`/wishlist/${listingId}`, {
        method: method,
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
        },
      });

      if (res.status === 401) {
        window.location.href = "/login";
        return;
      }

      const data = await res.json();
      if (data && data.success) {
        if (data.wishlisted) {
          icon.classList.remove("fa-regular");
          icon.classList.add("fa-solid", "text-danger");
          textSpan.textContent = "Saved in Wishlist";
        } else {
          icon.classList.remove("fa-solid", "text-danger");
          icon.classList.add("fa-regular");
          textSpan.textContent = "Add to Wishlist";
        }
      }
    } catch (err) {
      console.error("Error toggling wishlist:", err);
    }
  }
</script>