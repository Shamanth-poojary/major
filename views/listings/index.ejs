<% layout("layouts/boilerplate") -%>

<%
  const safeListings = (typeof alllistings !== 'undefined' && Array.isArray(alllistings)) ? alllistings : ((typeof listings !== 'undefined' && Array.isArray(listings)) ? listings : []);
  const safeWishlist = (typeof wishlistListingIds !== 'undefined' && wishlistListingIds) ? wishlistListingIds : new Set();

  // Curate 4-5 handpicked luxury stays for the Featured Listings banner
  const featuredCandidates = safeListings.filter(l =>
    /villa|heritage|penthouse|suite|retreat|cottage/i.test(l.title || "")
  );
  const featuredSlides = (featuredCandidates.length >= 3)
    ? featuredCandidates.slice(0, 5)
    : (safeListings.length > 0 ? safeListings.slice(0, 5) : [
        { id: 79, title: "Riverside Villa with Garden", location: "Udaipur, Rajasthan", country: "India", price: 7500, avgRating: 4.9, reviewCount: 210, image: { url: "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1600&q=80" } },
        { id: 81, title: "Sunlit Courtyard Room", location: "Pushkar, Rajasthan", country: "India", price: 9900, avgRating: 4.9, reviewCount: 185, image: { url: "https://picsum.photos/seed/wanderlust-aarav_heritage-4/1200/800" } },
        { id: 82, title: "Beachside Villa with Pool", location: "Anjuna, Goa", country: "India", price: 8900, avgRating: 4.8, reviewCount: 142, image: { url: "https://picsum.photos/seed/wanderlust-goa_getaways-1/1200/800" } },
        { id: 83, title: "Historic Villa & Vineyard", location: "Florence, Tuscany", country: "Italy", price: 14500, avgRating: 5.0, reviewCount: 96, image: { url: "https://picsum.photos/seed/wanderlust-tuscany_villas-1/1200/800" } }
      ]);
%>

<div class="wl-home-container">

  <!-- 1. Sleek Floating Search & Filter Pill Bar with Custom Dropdowns -->
  <div class="wl-search-pill-wrapper">
    <form id="homeSearchForm" action="/listings" method="GET" class="wl-search-pill">
      <!-- Search Input -->
      <div class="wl-search-pill-input-group">
        <i class="fa-solid fa-magnifying-glass text-muted ms-1" style="font-size: 0.95rem;"></i>
        <input
          type="text"
          name="search"
          id="homeSearchInput"
          class="wl-search-pill-input"
          placeholder="Search destinations, properties..."
          value="<%= typeof search !== 'undefined' ? search : '' %>"
          autocomplete="off"
        />
      </div>

      <div class="wl-search-pill-divider"></div>

      <!-- Hidden form inputs for compatibility & URL query params -->
      <input type="hidden" name="category" id="homeCategoryInput" value="<%= (typeof category !== 'undefined' && category) ? category : 'all' %>" />
      <input type="hidden" name="priceRange" id="homePriceInput" value="<%= (typeof priceRange !== 'undefined' && priceRange) ? priceRange : 'all' %>" />
      <input type="hidden" name="sort" id="homeSortInput" value="<%= (typeof sort !== 'undefined' && sort) ? sort : 'default' %>" />

      <!-- Category Custom Dropdown -->
      <div class="wl-search-pill-dropdown-wrap" id="pillDropdownCategory">
        <button type="button" class="wl-search-pill-dropdown-btn">
          <span class="d-flex align-items-center gap-2 text-truncate">
            <i class="fa-solid <%= (category === 'villa') ? 'fa-house-chimney text-primary' : (category === 'hotel' ? 'fa-city text-teal-600' : (category === 'cottage' ? 'fa-tree text-success' : (category === 'venue' ? 'fa-gem text-warning' : (category === 'retreat' ? 'fa-mountain text-info' : 'fa-hotel text-muted')))) %> filter-icon" style="font-size: 0.88rem;"></i>
            <span class="filter-label fw-medium"><%= (category === 'villa') ? 'Villas' : (category === 'hotel' ? 'Hotels' : (category === 'cottage' ? 'Cottages' : (category === 'venue' ? 'Venues' : (category === 'retreat' ? 'Retreats' : 'All Types')))) %></span>
          </span>
          <i class="fa-solid fa-chevron-down chevron-icon ms-1"></i>
        </button>

        <div class="wl-search-pill-dropdown-menu">
          <div class="wl-search-pill-dropdown-item <%= (!category || category === 'all') ? 'active' : '' %>" data-field="category" data-value="all" data-label="All Types" data-icon="fa-hotel text-muted">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-hotel text-secondary" style="width: 18px;"></i> All Types
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (category === 'villa') ? 'active' : '' %>" data-field="category" data-value="villa" data-label="Villas" data-icon="fa-house-chimney text-primary">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-house-chimney text-primary" style="width: 18px;"></i> Villas &amp; Estates
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (category === 'hotel') ? 'active' : '' %>" data-field="category" data-value="hotel" data-label="Hotels" data-icon="fa-city text-teal-600">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-city text-teal-600" style="width: 18px;"></i> Hotels &amp; Suites
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (category === 'cottage') ? 'active' : '' %>" data-field="category" data-value="cottage" data-label="Cottages" data-icon="fa-tree text-success">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-tree text-success" style="width: 18px;"></i> Hill Cottages
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (category === 'venue') ? 'active' : '' %>" data-field="category" data-value="venue" data-label="Venues" data-icon="fa-gem text-warning">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-gem text-warning" style="width: 18px;"></i> Event Venues
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (category === 'retreat') ? 'active' : '' %>" data-field="category" data-value="retreat" data-label="Retreats" data-icon="fa-mountain text-info">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-mountain text-info" style="width: 18px;"></i> Nature Retreats
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
        </div>
      </div>

      <div class="wl-search-pill-divider"></div>

      <!-- Price Range Custom Dropdown -->
      <div class="wl-search-pill-dropdown-wrap" id="pillDropdownPrice">
        <button type="button" class="wl-search-pill-dropdown-btn">
          <span class="d-flex align-items-center gap-2 text-truncate">
            <i class="fa-solid fa-tag text-muted filter-icon" style="font-size: 0.88rem;"></i>
            <span class="filter-label fw-medium">Any Price</span>
          </span>
          <i class="fa-solid fa-chevron-down chevron-icon ms-1"></i>
        </button>

        <div class="wl-search-pill-dropdown-menu">
          <div class="wl-search-pill-dropdown-item active" data-field="priceRange" data-value="all" data-label="Any Price" data-icon="fa-tag text-muted">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-tag text-secondary" style="width: 18px;"></i> Any Price
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item" data-field="priceRange" data-value="under_4000" data-label="Under ₹4,000" data-icon="fa-coins text-success">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-coins text-success" style="width: 18px;"></i> Under &#8377;4,000 <span class="text-muted small ms-1">(Budget)</span>
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item" data-field="priceRange" data-value="4000_8000" data-label="₹4k - ₹8k" data-icon="fa-money-bill-wave text-primary">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-money-bill-wave text-primary" style="width: 18px;"></i> &#8377;4,000 - &#8377;8,000 <span class="text-muted small ms-1">(Popular)</span>
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item" data-field="priceRange" data-value="above_8000" data-label="₹8,000+" data-icon="fa-crown text-warning">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-crown text-warning" style="width: 18px;"></i> &#8377;8,000+ <span class="text-muted small ms-1">(Luxury)</span>
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
        </div>
      </div>

      <div class="wl-search-pill-divider"></div>

      <!-- Sort Custom Dropdown -->
      <div class="wl-search-pill-dropdown-wrap" id="pillDropdownSort">
        <button type="button" class="wl-search-pill-dropdown-btn">
          <span class="d-flex align-items-center gap-2 text-truncate">
            <i class="fa-solid fa-arrow-down-wide-short text-muted filter-icon" style="font-size: 0.88rem;"></i>
            <span class="filter-label fw-medium">Recommended</span>
          </span>
          <i class="fa-solid fa-chevron-down chevron-icon ms-1"></i>
        </button>

        <div class="wl-search-pill-dropdown-menu" style="right: 0; left: auto;">
          <div class="wl-search-pill-dropdown-item <%= (!sort || sort === 'default') ? 'active' : '' %>" data-field="sort" data-value="default" data-label="Recommended" data-icon="fa-sparkles text-warning">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-sparkles text-warning" style="width: 18px;"></i> Recommended
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (sort === 'price_asc') ? 'active' : '' %>" data-field="sort" data-value="price_asc" data-label="Price: Low-High" data-icon="fa-arrow-down-1-9 text-secondary">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-arrow-down-1-9 text-secondary" style="width: 18px;"></i> Price: Low to High
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (sort === 'price_desc') ? 'active' : '' %>" data-field="sort" data-value="price_desc" data-label="Price: High-Low" data-icon="fa-arrow-down-9-1 text-secondary">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-arrow-down-9-1 text-secondary" style="width: 18px;"></i> Price: High to Low
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
          <div class="wl-search-pill-dropdown-item <%= (sort === 'rating') ? 'active' : '' %>" data-field="sort" data-value="rating" data-label="Top Rated" data-icon="fa-star text-warning">
            <span class="d-flex align-items-center gap-2">
              <i class="fa-solid fa-star text-warning" style="width: 18px;"></i> Top Rated
            </span>
            <i class="fa-solid fa-check check-icon"></i>
          </div>
        </div>
      </div>

      <!-- Search Button -->
      <button type="submit" id="homeSearchBtn" class="wl-search-pill-btn">
        <i class="fa-solid fa-magnifying-glass me-1"></i>
        <span>Search</span>
      </button>
    </form>
  </div>

  <!-- 2. Featured Listings Section -->
  <section class="wl-featured-section mb-5">
    <div class="wl-featured-header">
      <h2>Featured Listings</h2>
      <p>Handpicked stays, venues and experiences</p>
    </div>

    <!-- Featured Carousel Container -->
    <div id="featuredCarousel" class="wl-featured-card">
      <% featuredSlides.forEach((item, index) => { %>
        <%
          const fSaved = safeWishlist.has(item.id);
          const fImg = (item.image && item.image.url) ? item.image.url : '/images/landing_hero.jpg';
          const fLoc = [item.location, item.country].filter(Boolean).join(", ") || 'Featured Destination';
          const fRating = item.avgRating || 4.9;
          const fReviews = item.reviewCount || 210;
        %>
        <div class="wl-featured-slide <%= index === 0 ? 'active' : '' %>" style="display: <%= index === 0 ? 'block' : 'none' %>; width: 100%; height: 100%; position: absolute; inset: 0;">
          <a href="/listings/<%= item.id %>" class="d-block w-100 h-100 position-relative text-decoration-none">
            <img
              src="<%= fImg %>"
              alt="<%= item.title %>"
              class="wl-featured-slide-img"
              loading="<%= index === 0 ? 'eager' : 'lazy' %>"
            />
            <div class="wl-featured-gradient"></div>

            <div class="wl-featured-overlay-content">
              <div>
                <h3 class="wl-featured-title"><%= item.title %></h3>
                <div class="wl-featured-location">
                  <i class="fa-solid fa-location-dot"></i>
                  <span><%= fLoc %></span>
                </div>
              </div>
              <div>
                <div class="wl-featured-price">
                  &#8377;<%= Number(item.price || 0).toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-white-50">/ night</span>
                </div>
                <div class="wl-featured-rating">
                  <i class="fa-solid fa-star text-warning"></i>
                  <span><%= fRating %></span>
                  <span class="text-white-50">(<%= fReviews %>)</span>
                </div>
              </div>
            </div>
          </a>

          <!-- Wishlist Heart Button -->
          <% if (typeof currentUser !== "undefined" && currentUser) { %>
            <button
              type="button"
              class="wl-floating-heart <%= fSaved ? 'is-saved' : '' %>"
              onclick="toggleWishlist(event, '<%= item.id %>', this)"
              aria-label="<%= fSaved ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
              title="Save to Wishlist"
            >
              <i class="<%= fSaved ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
            </button>
          <% } else { %>
            <a
              href="/login"
              class="wl-floating-heart"
              aria-label="Login to add to Wishlist"
              title="Login to add to Wishlist"
            >
              <i class="fa-regular fa-heart"></i>
            </a>
          <% } %>
        </div>
      <% }); %>

      <!-- Left / Right Carousel Controls -->
      <button type="button" class="wl-featured-nav-btn prev" id="featuredPrevBtn" aria-label="Previous Featured Slide">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="wl-featured-nav-btn next" id="featuredNextBtn" aria-label="Next Featured Slide">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>

    <!-- Carousel Dots Indicators -->
    <div class="wl-featured-dots" id="featuredDotsContainer">
      <% featuredSlides.forEach((item, index) => { %>
        <button
          type="button"
          class="wl-featured-dot <%= index === 0 ? 'active' : '' %>"
          data-slide-index="<%= index %>"
          aria-label="Slide <%= index + 1 %>"
        ></button>
      <% }); %>
    </div>
  </section>

  <!-- 3. Trending Listings Section (Responsive 4-column Grid) -->
  <section class="wl-trending-section">
    <div class="wl-trending-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h3 id="trendingHeading">Trending Listings</h3>
      <span class="text-muted small fw-medium" id="trendingCountLabel">
        Showing <%= safeListings.length %> <%= safeListings.length === 1 ? 'stay' : 'stays' %>
      </span>
    </div>

    <!-- Listings Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="trendingListingsGrid">
      <% if (safeListings && safeListings.length > 0) { %>
        <% for (let listing of safeListings) { %>
          <%
            const isSaved = safeWishlist.has(listing.id);
            const locText = [listing.location, listing.country].filter(Boolean).join(", ") || 'Verified stay';
            const imgUrl = (listing.image && listing.image.url) ? listing.image.url : '/images/landing_hero.jpg';
          %>
          <div
            class="col wl-listing-item"
            data-id="<%= listing.id %>"
            data-title="<%= (listing.title || '').toLowerCase() %>"
            data-location="<%= (locText || '').toLowerCase() %>"
            data-price="<%= listing.price || 0 %>"
            data-category="<%= ((listing.businessType || '') + ' ' + (listing.title || '') + ' ' + (listing.description || '')).toLowerCase() %>"
          >
            <div class="wl-trending-card">
              <!-- Image & Heart Button -->
              <div class="wl-trending-img-wrap">
                <a href="/listings/<%= listing.id %>" class="d-block w-100 h-100">
                  <img
                    src="<%= imgUrl %>"
                    class="wl-trending-img"
                    alt="<%= listing.title %>"
                    loading="lazy"
                  />
                </a>

                <% if (typeof currentUser !== "undefined" && currentUser) { %>
                  <button
                    type="button"
                    class="wl-trending-heart <%= isSaved ? 'is-saved' : '' %>"
                    onclick="toggleWishlist(event, '<%= listing.id %>', this)"
                    aria-label="<%= isSaved ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
                    title="Save to Wishlist"
                  >
                    <i class="<%= isSaved ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                  </button>
                <% } else { %>
                  <a
                    href="/login"
                    class="wl-trending-heart"
                    aria-label="Login to add to Wishlist"
                    title="Login to add to Wishlist"
                  >
                    <i class="fa-regular fa-heart"></i>
                  </a>
                <% } %>
              </div>

              <!-- Info Body -->
              <div class="wl-trending-info">
                <h4 class="wl-trending-title">
                  <a href="/listings/<%= listing.id %>" class="text-decoration-none text-dark" title="<%= listing.title %>">
                    <%= listing.title %>
                  </a>
                </h4>
                <div class="wl-trending-location">
                  <i class="fa-solid fa-location-dot" style="font-size: 0.78rem;"></i>
                  <span><%= locText %></span>
                </div>
                <div class="wl-trending-price">
                  &#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %>
                  <span class="wl-trending-price-unit">/ night</span>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>

    <!-- Empty State (Shown when filters produce 0 matches) -->
    <div
      id="trendingEmptyState"
      class="wl-card text-center p-5 my-4 <%= (safeListings && safeListings.length > 0) ? 'd-none' : '' %>"
      style="border-radius: var(--wl-radius-xl);"
    >
      <div class="wl-empty-state py-4">
        <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3 opacity-50"></i>
        <h4 class="fw-bold text-dark mb-2">No listings found</h4>
        <p class="text-muted mb-4" style="max-width: 440px; margin: 0 auto;">
          We couldn't find any stays or venues matching your current filters. Try searching for another destination or resetting your filters.
        </p>
        <button type="button" class="btn wl-btn-primary rounded-pill px-4" id="btnResetFilters">
          <i class="fa-solid fa-rotate-left me-2"></i>Clear All Filters
        </button>
      </div>
    </div>
  </section>
</div>

<!-- Dynamic Live Filtering, Custom Dropdown Popups, Featured Carousel, & Wishlist Script -->
<script>
  (function () {
    // ----------------------------------------------------
    // 1. Featured Carousel Slider
    // ----------------------------------------------------
    const slides = document.querySelectorAll(".wl-featured-slide");
    const dots = document.querySelectorAll(".wl-featured-dot");
    const prevBtn = document.getElementById("featuredPrevBtn");
    const nextBtn = document.getElementById("featuredNextBtn");
    let currentSlide = 0;
    let autoPlayTimer = null;

    function showSlide(index) {
      if (!slides.length) return;
      slides[currentSlide].style.display = "none";
      slides[currentSlide].classList.remove("active");
      if (dots[currentSlide]) dots[currentSlide].classList.remove("active");

      currentSlide = (index + slides.length) % slides.length;

      slides[currentSlide].style.display = "block";
      slides[currentSlide].classList.add("active");
      if (dots[currentSlide]) dots[currentSlide].classList.add("active");
    }

    function nextSlide() {
      showSlide(currentSlide + 1);
    }
    function prevSlide() {
      showSlide(currentSlide - 1);
    }

    if (prevBtn) prevBtn.addEventListener("click", () => { prevSlide(); resetAutoplay(); });
    if (nextBtn) nextBtn.addEventListener("click", () => { nextSlide(); resetAutoplay(); });

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        showSlide(idx);
        resetAutoplay();
      });
    });

    function startAutoplay() {
      if (slides.length > 1) {
        autoPlayTimer = setInterval(nextSlide, 5000);
      }
    }
    function resetAutoplay() {
      clearInterval(autoPlayTimer);
      startAutoplay();
    }
    startAutoplay();

    // ----------------------------------------------------
    // 2. Custom Filter Dropdowns (Category, Price, Sort)
    // ----------------------------------------------------
    document.querySelectorAll(".wl-search-pill-dropdown-wrap").forEach(wrap => {
      const btn = wrap.querySelector(".wl-search-pill-dropdown-btn");
      if (btn) {
        btn.addEventListener("click", e => {
          e.stopPropagation();
          const wasOpen = wrap.classList.contains("show");
          document.querySelectorAll(".wl-search-pill-dropdown-wrap.show").forEach(d => d.classList.remove("show"));
          if (!wasOpen) wrap.classList.add("show");
        });
      }

      wrap.querySelectorAll(".wl-search-pill-dropdown-item").forEach(item => {
        item.addEventListener("click", e => {
          e.stopPropagation();
          const field = item.getAttribute("data-field");
          const val = item.getAttribute("data-value");
          const label = item.getAttribute("data-label");
          const iconClass = item.getAttribute("data-icon");

          // Update active item styling
          wrap.querySelectorAll(".wl-search-pill-dropdown-item").forEach(i => i.classList.remove("active"));
          item.classList.add("active");

          // Update trigger label and icon
          const labelEl = wrap.querySelector(".filter-label");
          if (labelEl) labelEl.textContent = label;
          const iconEl = wrap.querySelector(".filter-icon");
          if (iconEl && iconClass) {
            iconEl.className = "fa-solid " + iconClass + " filter-icon";
          }

          // Update underlying hidden inputs
          if (field === "category") {
            const input = document.getElementById("homeCategoryInput");
            if (input) input.value = val;
          } else if (field === "priceRange") {
            const input = document.getElementById("homePriceInput");
            if (input) input.value = val;
          } else if (field === "sort") {
            const input = document.getElementById("homeSortInput");
            if (input) input.value = val;
          }

          // Close dropdown
          wrap.classList.remove("show");

          // Apply live filters instantly!
          applyLiveFilters();
        });
      });
    });

    // Close dropdowns on outside click
    document.addEventListener("click", e => {
      if (!e.target.closest(".wl-search-pill-dropdown-wrap")) {
        document.querySelectorAll(".wl-search-pill-dropdown-wrap.show").forEach(d => d.classList.remove("show"));
      }
    });

    // ----------------------------------------------------
    // 3. Working Live Filter & Client-side Instant Filter
    // ----------------------------------------------------
    const searchInput = document.getElementById("homeSearchInput");
    const catInput = document.getElementById("homeCategoryInput");
    const prInput = document.getElementById("homePriceInput");
    const sortInput = document.getElementById("homeSortInput");
    const listingsGrid = document.getElementById("trendingListingsGrid");
    const emptyState = document.getElementById("trendingEmptyState");
    const countLabel = document.getElementById("trendingCountLabel");
    const resetBtn = document.getElementById("btnResetFilters");

    function applyLiveFilters() {
      const q = (searchInput ? searchInput.value : "").trim().toLowerCase();
      const cat = catInput ? catInput.value : "all";
      const pr = prInput ? prInput.value : "all";
      const sortVal = sortInput ? sortInput.value : "default";

      const items = Array.from(document.querySelectorAll(".wl-listing-item"));
      let visibleCount = 0;

      items.forEach(item => {
        const title = item.getAttribute("data-title") || "";
        const location = item.getAttribute("data-location") || "";
        const categoryData = item.getAttribute("data-category") || "";
        const price = parseFloat(item.getAttribute("data-price") || "0");

        // Keyword Match
        let matchesQuery = true;
        if (q) {
          matchesQuery = title.includes(q) || location.includes(q) || categoryData.includes(q);
        }

        // Category Match
        let matchesCategory = true;
        if (cat !== "all") {
          matchesCategory = categoryData.includes(cat) || title.includes(cat);
        }

        // Price Match
        let matchesPrice = true;
        if (pr === "under_4000") {
          matchesPrice = price < 4000;
        } else if (pr === "4000_8000") {
          matchesPrice = price >= 4000 && price <= 8000;
        } else if (pr === "above_8000") {
          matchesPrice = price > 8000;
        }

        if (matchesQuery && matchesCategory && matchesPrice) {
          item.style.display = "";
          visibleCount++;
        } else {
          item.style.display = "none";
        }
      });

      // Sort visible items
      if (listingsGrid) {
        const visibleItems = items.filter(i => i.style.display !== "none");
        if (sortVal === "price_asc") {
          visibleItems.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
          visibleItems.forEach(i => listingsGrid.appendChild(i));
        } else if (sortVal === "price_desc") {
          visibleItems.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
          visibleItems.forEach(i => listingsGrid.appendChild(i));
        }
      }

      // Update Count & Empty State
      if (countLabel) {
        countLabel.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'stay' : 'stays'}`;
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove("d-none");
        } else {
          emptyState.classList.add("d-none");
        }
      }
    }

    // Debounce search typing
    let debounceTimer = null;
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(applyLiveFilters, 180);
      });
    }

    // Reset filters
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (searchInput) searchInput.value = "";
        if (catInput) catInput.value = "all";
        if (prInput) prInput.value = "all";
        if (sortInput) sortInput.value = "default";

        // Reset UI triggers
        const catWrap = document.getElementById("pillDropdownCategory");
        if (catWrap) {
          catWrap.querySelector(".filter-label").textContent = "All Types";
          catWrap.querySelector(".filter-icon").className = "fa-solid fa-hotel text-muted filter-icon";
          catWrap.querySelectorAll(".wl-search-pill-dropdown-item").forEach(i => i.classList.toggle("active", i.getAttribute("data-value") === "all"));
        }
        const prWrap = document.getElementById("pillDropdownPrice");
        if (prWrap) {
          prWrap.querySelector(".filter-label").textContent = "Any Price";
          prWrap.querySelectorAll(".wl-search-pill-dropdown-item").forEach(i => i.classList.toggle("active", i.getAttribute("data-value") === "all"));
        }
        const sortWrap = document.getElementById("pillDropdownSort");
        if (sortWrap) {
          sortWrap.querySelector(".filter-label").textContent = "Recommended";
          sortWrap.querySelectorAll(".wl-search-pill-dropdown-item").forEach(i => i.classList.toggle("active", i.getAttribute("data-value") === "default"));
        }

        applyLiveFilters();
      });
    }

    applyLiveFilters();
  })();

  // ----------------------------------------------------
  // 4. Wishlist Toggle AJAX (Global)
  // ----------------------------------------------------
  async function toggleWishlist(event, listingId, btn) {
    event.preventDefault();
    event.stopPropagation();
    const icon = btn.querySelector("i");
    const isSaved = icon.classList.contains("fa-solid");
    const method = isSaved ? "DELETE" : "POST";

    // Optimistic UI toggle
    if (isSaved) {
      icon.classList.remove("fa-solid", "text-danger");
      icon.classList.add("fa-regular");
      btn.classList.remove("is-saved");
    } else {
      icon.classList.remove("fa-regular");
      icon.classList.add("fa-solid", "text-danger");
      btn.classList.add("is-saved");
    }

    try {
      const res = await fetch(`/wishlist/${listingId}`, {
        method: method,
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
        },
      });

      if (res.status === 401) {
        window.location.href = "/login";
        return;
      }

      const data = await res.json();
      if (!data || !data.success) {
        // Rollback
        if (isSaved) {
          icon.classList.remove("fa-regular");
          icon.classList.add("fa-solid", "text-danger");
          btn.classList.add("is-saved");
        } else {
          icon.classList.remove("fa-solid", "text-danger");
          icon.classList.add("fa-regular");
          btn.classList.remove("is-saved");
        }
      }
    } catch (err) {
      console.error("Error toggling wishlist:", err);
      // Rollback
      if (isSaved) {
        icon.classList.remove("fa-regular");
        icon.classList.add("fa-solid", "text-danger");
        btn.classList.add("is-saved");
      } else {
        icon.classList.remove("fa-solid", "text-danger");
        icon.classList.add("fa-regular");
        btn.classList.remove("is-saved");
      }
    }
  }
</script>
