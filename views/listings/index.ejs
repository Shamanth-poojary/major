<% layout("layouts/boilerplate") -%>

<div class="wl-container py-4 py-md-5">
  <!-- Page Header -->
  <div class="mb-4">
    <h1 class="h2 fw-bold text-dark mb-3">All Listings</h1>

    <!-- Filter Chips Row (Mockup Ref 04) -->
    <div class="d-flex align-items-center flex-wrap gap-2">
      <button
        type="button"
        class="btn btn-sm rounded-pill px-3 py-2 fw-semibold"
        style="background-color: var(--wl-accent-600); color: #FFFFFF; border: none;"
      >
        All
      </button>
      <button
        type="button"
        class="btn btn-sm rounded-pill px-3 py-2 fw-semibold bg-white border text-secondary"
        style="border-color: var(--wl-border) !important;"
      >
        Hotels
      </button>
      <button
        type="button"
        class="btn btn-sm rounded-pill px-3 py-2 fw-semibold bg-white border text-secondary"
        style="border-color: var(--wl-border) !important;"
      >
        Properties
      </button>
      <button
        type="button"
        class="btn btn-sm rounded-pill px-3 py-2 fw-semibold bg-white border text-secondary"
        style="border-color: var(--wl-border) !important;"
      >
        Venues
      </button>
    </div>
  </div>

  <!-- Listings Grid -->
  <% if (alllistings && alllistings.length > 0) { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% for (let listing of alllistings) { %>
        <%
          const isSaved = (typeof wishlistListingIds !== "undefined" && wishlistListingIds && wishlistListingIds.has(listing.id));
          const locationDisplay = listing.location
            ? (listing.country ? `${listing.location}, ${listing.country}` : listing.location)
            : (listing.country || 'Featured destination');
        %>
        <div class="col">
          <div class="wl-listing-card">
            <!-- Image & Heart Button -->
            <div class="wl-listing-img-wrap">
              <a href="/listings/<%= listing.id %>" class="d-block w-100 h-100">
                <img
                  src="<%= listing.image ? listing.image.url : '/images/landing_hero.jpg' %>"
                  class="wl-listing-img"
                  alt="<%= listing.title %>"
                  loading="lazy"
                />
              </a>

              <!-- Wishlist Heart Button -->
              <% if (typeof currentUser !== "undefined" && currentUser) { %>
                <button
                  type="button"
                  class="wl-heart-btn <%= isSaved ? 'is-saved' : '' %>"
                  onclick="toggleWishlist(event, '<%= listing.id %>', this)"
                  aria-label="<%= isSaved ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
                  title="<%= isSaved ? 'Remove from Wishlist' : 'Add to Wishlist' %>"
                >
                  <i class="<%= isSaved ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                </button>
              <% } else { %>
                <a
                  href="/login"
                  class="wl-heart-btn"
                  aria-label="Login to add to Wishlist"
                  title="Login to add to Wishlist"
                >
                  <i class="fa-regular fa-heart"></i>
                </a>
              <% } %>
            </div>

            <!-- Card Content Body -->
            <a href="/listings/<%= listing.id %>" class="text-decoration-none text-dark flex-grow-1 d-flex flex-column">
              <div class="wl-listing-body">
                <h2 class="wl-listing-title text-truncate" title="<%= listing.title %>">
                  <%= listing.title %>
                </h2>
                <div class="wl-listing-location text-truncate">
                  <i class="fa-solid fa-location-dot text-muted"></i>
                  <span><%= locationDisplay %></span>
                </div>
                <div class="wl-listing-footer">
                  <span class="wl-listing-price">
                    &#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 'N/A' %>
                  </span>
                  <span class="wl-listing-unit">/ night</span>
                </div>
              </div>
            </a>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="wl-card text-center p-5 my-4">
      <div class="wl-empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--wl-teal-500)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <h3 class="h4 fw-bold text-dark mt-3 mb-2">No Listings Found</h3>
        <p class="text-muted mb-4">There are currently no listings available. Check back soon!</p>
      </div>
    </div>
  <% } %>
</div>

<!-- Wishlist AJAX Handler (Optimistic with Rollback) -->
<script>
  async function toggleWishlist(event, listingId, btn) {
    event.preventDefault();
    event.stopPropagation();
    const icon = btn.querySelector("i");
    const isSaved = icon.classList.contains("fa-solid");
    const method = isSaved ? "DELETE" : "POST";

    // Optimistic toggle
    if (isSaved) {
      icon.classList.remove("fa-solid", "text-danger");
      icon.classList.add("fa-regular");
      btn.classList.remove("is-saved");
    } else {
      icon.classList.remove("fa-regular");
      icon.classList.add("fa-solid", "text-danger");
      btn.classList.add("is-saved");
    }

    try {
      const res = await fetch(`/wishlist/${listingId}`, {
        method: method,
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json",
        },
      });

      if (res.status === 401) {
        window.location.href = "/login";
        return;
      }

      const data = await res.json();
      if (!data || !data.success) {
        // Rollback on failure
        if (isSaved) {
          icon.classList.remove("fa-regular");
          icon.classList.add("fa-solid", "text-danger");
          btn.classList.add("is-saved");
        } else {
          icon.classList.remove("fa-solid", "text-danger");
          icon.classList.add("fa-regular");
          btn.classList.remove("is-saved");
        }
      }
    } catch (err) {
      console.error("Error toggling wishlist:", err);
      // Rollback on network error
      if (isSaved) {
        icon.classList.remove("fa-regular");
        icon.classList.add("fa-solid", "text-danger");
        btn.classList.add("is-saved");
      } else {
        icon.classList.remove("fa-solid", "text-danger");
        icon.classList.add("fa-regular");
        btn.classList.remove("is-saved");
      }
    }
  }
</script>
