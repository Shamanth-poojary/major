<% layout("layouts/boilerplate") -%>

<div class="wl-container py-4 py-md-5">
  <!-- Breadcrumb -->
  <div class="wl-breadcrumb mb-3">
    <a href="/dashboard/listings" class="text-muted text-decoration-none">My Listings</a>
    <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
    <a href="/listings/<%= listing.id %>" class="text-muted text-decoration-none text-truncate" style="max-width: 200px;"><%= listing.title %></a>
    <i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i>
    <span class="text-dark fw-semibold">Manage Rooms & Payment Policy</span>
  </div>

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
    <div>
      <h1 class="h3 fw-bold text-dark mb-1">
        <i class="fa-solid fa-bed me-2 text-primary"></i>Room Types & Pricing for <%= listing.title %>
      </h1>
      <p class="text-muted mb-0">Define room categories, available units, nightly rates, amenities, and advance booking rules.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <button type="button" class="btn btn-outline-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#generateModal">
        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>AI Room Generator
      </button>
      <button type="button" class="btn btn-primary btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addRoomModal">
        <i class="fa-solid fa-plus me-1"></i>Add Room Type
      </button>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Room Types List -->
    <div class="col-12 col-lg-8">
      <div class="d-flex flex-column gap-3">
        <% if (rooms && rooms.length > 0) { %>
          <% for (let room of rooms) { %>
            <div class="card border rounded-3 p-3 shadow-sm <%= !room.is_active ? 'opacity-50 bg-light' : '' %>">
              <div class="row g-3 align-items-center">
                <div class="col-12 col-md-3">
                  <img
                    src="<%= room.image_url || listing.image.url %>"
                    alt="<%= room.name %>"
                    class="rounded-3 w-100"
                    style="height: 100px; object-fit: cover;"
                  />
                </div>
                <div class="col-12 col-md-6">
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <h5 class="fw-bold text-dark mb-0"><%= room.name %></h5>
                    <span class="badge bg-secondary text-uppercase" style="font-size: 0.65rem;"><%= room.category %></span>
                    <% if (room.is_auto_generated) { %>
                      <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" style="font-size: 0.65rem;">Auto-Generated</span>
                    <% } %>
                    <% if (!room.is_active) { %>
                      <span class="badge bg-danger" style="font-size: 0.65rem;">Inactive</span>
                    <% } %>
                  </div>

                  <p class="text-muted small mb-1 text-truncate" style="max-width: 400px;">
                    <%= room.description || 'No description provided.' %>
                  </p>

                  <div class="text-muted small">
                    <span><i class="fa-solid fa-users me-1"></i><%= room.max_guests %> guests</span>
                    <span class="mx-1">&middot;</span>
                    <span><i class="fa-solid fa-layer-group me-1"></i><%= room.total_units %> total unit(s)</span>
                    <% if (room.bed_config) { %>
                      <span class="mx-1">&middot;</span>
                      <span><%= room.bed_config %></span>
                    <% } %>
                  </div>

                  <% if (room.amenities && room.amenities.length > 0) { %>
                    <div class="d-flex flex-wrap gap-1 mt-2">
                      <% for (let a of room.amenities.slice(0, 4)) { %>
                        <span class="badge bg-light text-dark border" style="font-size: 0.68rem;"><%= a %></span>
                      <% } %>
                      <% if (room.amenities.length > 4) { %>
                        <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">+<%= room.amenities.length - 4 %></span>
                      <% } %>
                    </div>
                  <% } %>
                </div>

                <div class="col-12 col-md-3 text-md-end border-start-md pt-2 pt-md-0">
                  <div class="h4 fw-bold text-dark mb-2">
                    &#8377;<%= Number(room.price_per_night).toLocaleString("en-IN") %>
                    <span class="fs-6 fw-normal text-muted">/ nt</span>
                  </div>

                  <div class="d-flex flex-wrap gap-1 justify-content-md-end">
                    <button
                      type="button"
                      class="btn btn-outline-secondary btn-sm px-2"
                      data-bs-toggle="modal"
                      data-bs-target="#editModal-<%= room.id %>"
                    >
                      <i class="fa-solid fa-pencil"></i>
                    </button>

                    <% if (room.is_active) { %>
                      <form action="/owner/rooms/<%= room.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Deactivate this room type? It will not be bookable for new dates.');">
                        <button type="submit" class="btn btn-outline-danger btn-sm px-2" title="Deactivate">
                          <i class="fa-solid fa-ban"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Edit Modal for this room -->
            <div class="modal fade" id="editModal-<%= room.id %>" tabindex="-1">
              <div class="modal-dialog modal-lg">
                <form action="/owner/rooms/<%= room.id %>" method="POST" class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title fw-bold">Edit <%= room.name %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
                    <div class="row g-3">
                      <div class="col-12 col-md-8">
                        <label class="form-label small fw-bold">Room Name</label>
                        <input type="text" name="name" class="form-control" value="<%= room.name %>" required />
                      </div>
                      <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold">Category</label>
                        <select name="category" class="form-select">
                          <option value="standard" <%= room.category === 'standard' ? 'selected' : '' %>>Standard</option>
                          <option value="deluxe" <%= room.category === 'deluxe' ? 'selected' : '' %>>Deluxe</option>
                          <option value="suite" <%= room.category === 'suite' ? 'selected' : '' %>>Suite</option>
                          <option value="family" <%= room.category === 'family' ? 'selected' : '' %>>Family</option>
                          <option value="entire_property" <%= room.category === 'entire_property' ? 'selected' : '' %>>Entire Property</option>
                          <option value="hall" <%= room.category === 'hall' ? 'selected' : '' %>>Hall / Venue</option>
                        </select>
                      </div>
                      <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold">Price / Night (&#8377;)</label>
                        <input type="number" name="price_per_night" class="form-control" value="<%= room.price_per_night %>" min="100" required />
                      </div>
                      <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold">Total Units Available</label>
                        <input type="number" name="total_units" class="form-control" value="<%= room.total_units %>" min="1" max="100" required />
                      </div>
                      <div class="col-12 col-md-4">
                        <label class="form-label small fw-bold">Max Guests / Unit</label>
                        <input type="number" name="max_guests" class="form-control" value="<%= room.max_guests %>" min="1" max="50" required />
                      </div>
                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold">Bed Configuration</label>
                        <input type="text" name="bed_config" class="form-control" value="<%= room.bed_config || '' %>" placeholder="e.g. 1 King Bed" />
                      </div>
                      <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold">Size (Sq Ft)</label>
                        <input type="number" name="size_sqft" class="form-control" value="<%= room.size_sqft || '' %>" placeholder="e.g. 350" />
                      </div>
                      <div class="col-12">
                        <label class="form-label small fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="2"><%= room.description || '' %></textarea>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                  </div>
                </form>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <div class="alert alert-warning p-4 rounded-3 text-center">
            <i class="fa-solid fa-triangle-exclamation display-6 d-block mb-2"></i>
            <h5 class="fw-bold">No Room Types Configured</h5>
            <p class="mb-3">This listing cannot accept bookings until at least one active room type is added.</p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
              <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Generate Suggested Rooms Now
            </button>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Payment Policy Settings -->
    <div class="col-12 col-lg-4">
      <div class="card border rounded-3 p-4 shadow-sm sticky-top" style="top: 88px;">
        <h4 class="h5 fw-bold text-dark mb-3">
          <i class="fa-solid fa-credit-card me-2 text-primary"></i>Advance Payment Policy
        </h4>
        <p class="text-muted small mb-3">
          Control whether travelers can confirm bookings with a partial advance deposit or must pay in full.
        </p>

        <form action="/owner/listings/<%= listing.id %>/payment-policy" method="POST">
          <div class="form-check form-switch mb-3">
            <input
              class="form-check-input"
              type="checkbox"
              id="allowAdvanceSwitch"
              name="allow_advance"
              <%= policy.allow_advance ? 'checked' : '' %>
            />
            <label class="form-check-label fw-bold text-dark" for="allowAdvanceSwitch">
              Allow Advance Booking
            </label>
            <div class="form-text">If turned off, guests must pay 100% upfront at booking.</div>
          </div>

          <div id="advanceConfigSection" class="<%= policy.allow_advance ? '' : 'd-none' %>">
            <div class="mb-3">
              <label class="form-label small fw-bold text-dark">Advance Deposit Type</label>
              <select name="advance_type" id="advanceTypeSelect" class="form-select form-select-sm">
                <option value="percent" <%= policy.advance_type === 'percent' ? 'selected' : '' %>>Percentage (%)</option>
                <option value="fixed" <%= policy.advance_type === 'fixed' ? 'selected' : '' %>>Fixed Amount (INR)</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold text-dark" id="advanceValueLabel">Deposit Value</label>
              <input
                type="number"
                name="advance_value"
                id="advanceValueInput"
                class="form-control"
                value="<%= policy.advance_value %>"
                min="1"
                step="1"
                required
              />
            </div>

            <div class="p-3 bg-light rounded-3 border small mb-3" id="policyExampleBox">
              <span class="fw-bold text-dark d-block mb-1">Live Calculation:</span>
              <span class="text-muted">On a &#8377;10,000 reservation, guest pays <strong class="text-primary" id="examplePay">&#8377;2,500</strong> now, and the remainder before check-in.</span>
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            Save Payment Policy
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Add Room Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <form action="/owner/listings/<%= listing.id %>/rooms" method="POST" class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">Add New Room Type</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12 col-md-8">
            <label class="form-label small fw-bold">Room Name</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Deluxe Garden Suite" required />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label small fw-bold">Category</label>
            <select name="category" class="form-select">
              <option value="standard" selected>Standard Room</option>
              <option value="deluxe">Deluxe Room</option>
              <option value="suite">Executive Suite</option>
              <option value="family">Family Room</option>
              <option value="entire_property">Entire Property</option>
              <option value="hall">Hall / Event Space</option>
            </select>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label small fw-bold">Nightly Rate (&#8377;)</label>
            <input type="number" name="price_per_night" class="form-control" placeholder="3500" min="100" required />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label small fw-bold">Total Units</label>
            <input type="number" name="total_units" class="form-control" value="1" min="1" max="100" required />
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label small fw-bold">Max Guests / Unit</label>
            <input type="number" name="max_guests" class="form-control" value="2" min="1" max="50" required />
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label small fw-bold">Bed Configuration</label>
            <input type="text" name="bed_config" class="form-control" placeholder="e.g. 1 King Bed" />
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label small fw-bold">Size (Sq Ft)</label>
            <input type="number" name="size_sqft" class="form-control" placeholder="350" />
          </div>
          <div class="col-12">
            <label class="form-label small fw-bold">Description</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Highlights and features of this room..."></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary px-4">Create Room Type</button>
      </div>
    </form>
  </div>
</div>

<!-- AI Generator Modal -->
<div class="modal fade" id="generateModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">
          <i class="fa-solid fa-wand-magic-sparkles text-primary me-2"></i>AI Suggested Room Configurations
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small">
          Our room generation model analyzes your listing's property type, title, and base price to configure optimal inventory.
        </p>

        <div id="generationSpinner" class="text-center py-4">
          <div class="spinner-border text-primary" role="status"></div>
          <div class="text-muted small mt-2">Generating optimal room types...</div>
        </div>

        <form id="bulkRoomsForm" action="/owner/listings/<%= listing.id %>/rooms/bulk" method="POST" class="d-none">
          <input type="hidden" name="rooms" id="bulkRoomsJson" value="" />
          <div id="suggestionsList" class="d-flex flex-column gap-3 mb-3"></div>

          <div class="d-flex justify-content-end gap-2 border-top pt-3">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-success px-4">
              <i class="fa-solid fa-check me-1"></i>Accept & Save All Rooms
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  // Toggle advance switch
  const switchEl = document.getElementById("allowAdvanceSwitch");
  const configSec = document.getElementById("advanceConfigSection");
  if (switchEl && configSec) {
    switchEl.addEventListener("change", () => {
      configSec.classList.toggle("d-none", !switchEl.checked);
    });
  }

  // Live example calculation
  const typeSelect = document.getElementById("advanceTypeSelect");
  const valInput = document.getElementById("advanceValueInput");
  const examplePay = document.getElementById("examplePay");

  function updateExample() {
    const val = Number(valInput.value) || 0;
    if (typeSelect.value === "percent") {
      const calc = Math.round((10000 * val) / 100);
      examplePay.textContent = "₹" + calc.toLocaleString("en-IN");
    } else {
      examplePay.textContent = "₹" + Math.min(10000, val).toLocaleString("en-IN");
    }
  }

  if (typeSelect && valInput) {
    typeSelect.addEventListener("change", updateExample);
    valInput.addEventListener("input", updateExample);
    updateExample();
  }

  // AI Generator fetch
  const genModal = document.getElementById("generateModal");
  if (genModal) {
    genModal.addEventListener("show.bs.modal", async () => {
      const spinner = document.getElementById("generationSpinner");
      const form = document.getElementById("bulkRoomsForm");
      const list = document.getElementById("suggestionsList");
      const jsonInput = document.getElementById("bulkRoomsJson");

      spinner.classList.remove("d-none");
      form.classList.add("d-none");
      list.innerHTML = "";

      try {
        const res = await fetch("/owner/listings/<%= listing.id %>/rooms/generate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });
        const data = await res.json();
        spinner.classList.add("d-none");
        form.classList.remove("d-none");

        jsonInput.value = JSON.stringify(data.suggestions);

        data.suggestions.forEach((s) => {
          const div = document.createElement("div");
          div.className = "card border p-3 rounded-3";
          div.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-1">
              <strong class="text-dark">${s.name}</strong>
              <span class="text-primary fw-bold">₹${s.price_per_night.toLocaleString("en-IN")} / nt</span>
            </div>
            <div class="text-muted small mb-2">${s.description}</div>
            <div class="text-muted small">
              <span class="badge bg-secondary text-uppercase">${s.category}</span>
              <span class="ms-2"><i class="fa-solid fa-users me-1"></i>${s.max_guests} Guests</span>
              <span class="ms-2"><i class="fa-solid fa-layer-group me-1"></i>${s.total_units} Unit(s)</span>
              ${s.bed_config ? `<span class="ms-2">&middot; ${s.bed_config}</span>` : ""}
            </div>
          `;
          list.appendChild(div);
        });
      } catch (err) {
        spinner.innerHTML = '<div class="alert alert-danger">Failed to fetch suggestions.</div>';
      }
    });
  }
});
</script>
