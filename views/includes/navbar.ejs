<nav class="navbar navbar-expand-lg wl-navbar sticky-top">
  <div class="wl-container d-flex align-items-center justify-content-between">
    <!-- Brand Logo -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <svg class="wl-brand-logo" width="34" height="24" viewBox="0 0 36 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="WanderLust Logo">
        <path d="M12 3L23 22H1L12 3Z" fill="#1C8387" />
        <path d="M22 8L31 22H13L22 8Z" fill="#137580" fill-opacity="0.9" />
        <path d="M7 13L13 22H1L7 13Z" fill="#0F515F" fill-opacity="0.8" />
      </svg>
      <span>WanderLust</span>
    </a>

    <button
      class="navbar-toggler border-0 p-1"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <i class="fa-solid fa-bars text-dark fs-5"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <!-- Left Navigation Links -->
      <div class="navbar-nav me-auto align-items-lg-center ms-lg-3 gap-lg-1">
        <a class="nav-link" href="/listings">Home</a>

        <% if (typeof canManageListings !== "undefined" && canManageListings) { %>
          <a class="nav-link" href="/listings/new">Add New Listing</a>
        <% } %>

        <% if (typeof currentUser !== "undefined" && currentUser) { %>
          <a class="nav-link" href="/dashboard">Dashboard</a>
        <% } %>

        <% if (typeof currentUser !== "undefined" && currentUser && currentUser.role === "owner") { %>
          <%
            const statusKey = currentUser.ownerStatus || "none";
            const pillClasses = {
              pending:  "wl-pill-pending",
              approved: "wl-pill-approved",
              rejected: "wl-pill-rejected",
              none:     "bg-light text-muted",
            };
            const statusLabels = {
              pending:  "Pending approval",
              approved: "Approved",
              rejected: "Not approved",
              none:     "Application not submitted",
            };
          %>
          <a class="nav-link d-inline-flex align-items-center gap-2" href="/owner/status">
            <span>Owner Status</span>
            <span class="wl-pill <%= pillClasses[statusKey] || 'wl-pill-pending' %>">
              <span class="wl-pill-dot"></span>
              <%= statusLabels[statusKey] || statusKey %>
            </span>
          </a>
        <% } %>

        <% if (typeof currentUser !== "undefined" && currentUser && currentUser.role === "admin") { %>
          <a class="nav-link d-inline-flex align-items-center gap-2" href="/dashboard/approvals">
            <span>Owner Applications</span>
            <% if (typeof pendingOwnerCount === "number" && pendingOwnerCount > 0) { %>
              <span class="wl-pill-count bg-danger text-white"><%= pendingOwnerCount %></span>
            <% } %>
          </a>
        <% } %>
      </div>

      <!-- Right Navigation Actions -->
      <div class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">
        <% if (typeof currentUser === "undefined" || !currentUser) { %>
          <a class="nav-link fw-semibold px-3" href="/signup">Register</a>
          <a class="btn wl-btn-primary px-3" href="/login">Login</a>
        <% } else { %>
          <div class="dropdown">
            <div
              class="wl-user-menu"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              role="button"
            >
              <% if (currentUser.profilePictureUrl) { %>
                <img
                  src="<%= currentUser.profilePictureUrl %>"
                  alt="<%= currentUser.username %>"
                  class="rounded-circle"
                  style="width: 28px; height: 28px; object-fit: cover;"
                />
              <% } else { %>
                <div
                  class="rounded-circle text-white d-flex align-items-center justify-content-center"
                  style="width: 28px; height: 28px; background-color: var(--wl-teal-500); font-size: 0.82rem; font-weight: 700;"
                >
                  <%= currentUser.username.charAt(0).toUpperCase() %>
                </div>
              <% } %>

              <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark fs-6"><%= currentUser.username %></span>
                <%
                  const roleBadgeClass = {
                    customer: 'bg-info-subtle text-info-emphasis',
                    owner:    'bg-primary-subtle text-primary-emphasis',
                    admin:    'bg-danger-subtle text-danger-emphasis'
                  };
                  const roleLabel = { customer: 'Traveller', owner: 'Owner', admin: 'Admin' };
                %>
                <span class="badge <%= roleBadgeClass[currentUser.role] || 'bg-light text-dark' %> rounded-pill px-2 py-1" style="font-size: 0.72rem;">
                  <%= roleLabel[currentUser.role] || currentUser.role %>
                </span>
              </div>
              <i class="fa-solid fa-chevron-down text-muted" style="font-size: 0.7rem; margin-left: 4px;"></i>
            </div>

            <ul class="dropdown-menu dropdown-menu-end shadow-sm border mt-2" style="border-radius: var(--wl-radius-md);">
              <li><a class="dropdown-item py-2" href="/dashboard/profile"><i class="fa-regular fa-user me-2 text-muted"></i>My Profile</a></li>
              <li><a class="dropdown-item py-2" href="/dashboard"><i class="fa-solid fa-gauge me-2 text-muted"></i>Dashboard</a></li>
              <li><a class="dropdown-item py-2" href="/dashboard/wishlist"><i class="fa-regular fa-heart me-2 text-muted"></i>Wishlist</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li><a class="dropdown-item py-2 text-danger" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Logout</a></li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
