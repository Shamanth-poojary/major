<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust — Find your next stay or venue</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- WanderLust Design System Tokens & Components -->
    <link rel="stylesheet" href="/css/theme.css" />
    <!-- Legacy Custom CSS -->
    <link rel="stylesheet" href="/css/style.css" />

    <!-- Mapbox GL JS -->
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v3.18.0/mapbox-gl.css"
      rel="stylesheet"
    />
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.18.0/mapbox-gl.js"></script>

    <!-- Rating CSS -->
    <link href="/css/rating.css" rel="stylesheet" />
  </head>

  <body>
    <!-- Header / Navbar -->
    <%- include("../includes/navbar.ejs") %>

    <div class="page-wrapper">
      <!-- Flash Messages -->
      <%- include("../includes/flash.ejs") %>

      <!-- Main Content -->
      <main class="flex-grow-1"><%- body %></main>
    </div>

    <!-- Footer -->
    <%- include("../includes/footer.ejs") %>

    <!-- Bootstrap JS Bundle -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>

    <!-- Client Validation & Logic -->
    <script src="/js/script.js"></script>
    <!-- Modern UI Interactions -->
    <script src="/js/ui.js"></script>
    <!-- Mapbox Logic -->
    <script src="/js/map.js"></script>
  </body>
</html>
