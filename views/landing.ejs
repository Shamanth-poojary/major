<% layout("layouts/boilerplate") -%>

<%
  const safeListingsData = (typeof listings !== 'undefined' && Array.isArray(listings)) ? listings : [];
  const heroQuotes = [
    { quote: "Escape the ordinary and discover a haven where tranquility meets luxury.", theme: "Beach & Coastal Escapes" },
    { quote: "Travel is the only thing you buy that makes you richer in spirit and memories.", theme: "Historic & Alpine Retreats" },
    { quote: "Every extraordinary journey begins with finding the perfect place to rest.", theme: "Iconic Urban Destinations" },
    { quote: "Collect unforgettable moments and golden sunsets, not just things.", theme: "Serene Nature & Cabins" },
    { quote: "Live with no excuses, travel with no regrets, and find your sanctuary.", theme: "Curated Boutique Venues" }
  ];

  // Pick up to 5 listings for hero slides (using real DB listings if available, otherwise rich fallbacks)
  const heroSlides = (safeListingsData.length > 0)
    ? safeListingsData.slice(0, 5)
    : [
        { id: 12, title: "Cozy Beachfront Cottage", location: "Malibu", country: "United States", price: 8500, image: { url: "/images/landing_hero.jpg" } },
        { id: 15, title: "Historic Villa in Tuscany", location: "Florence", country: "Italy", price: 15000, image: { url: "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=1600&q=80" } },
        { id: 14, title: "Mountain Retreat", location: "Aspen", country: "United States", price: 12000, image: { url: "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1600&q=80" } },
        { id: 13, title: "Modern Loft in Downtown", location: "New York City", country: "United States", price: 9500, image: { url: "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=1600&q=80" } },
        { id: 21, title: "Safari Lodge in the Serengeti", location: "Serengeti National Park", country: "Tanzania", price: 18000, image: { url: "https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1600&q=80" } }
      ];
%>

<!-- Dynamic Hero Slideshow with Quotes and Highlighted Listings -->
<section id="heroDynamicSlider" class="carousel slide carousel-fade wl-hero-carousel position-relative text-white" data-bs-ride="carousel" data-bs-interval="6500">
  <!-- Indicators -->
  <div class="carousel-indicators wl-hero-indicators">
    <% heroSlides.forEach((item, idx) => { %>
      <button
        type="button"
        data-bs-target="#heroDynamicSlider"
        data-bs-slide-to="<%= idx %>"
        class="<%= idx === 0 ? 'active' : '' %>"
        aria-current="<%= idx === 0 ? 'true' : 'false' %>"
        aria-label="Slide <%= idx + 1 %>"
      ></button>
    <% }); %>
  </div>

  <div class="carousel-inner">
    <% heroSlides.forEach((listing, idx) => { %>
      <% const qObj = heroQuotes[idx % heroQuotes.length]; %>
      <div class="carousel-item <%= idx === 0 ? 'active' : '' %>" style="min-height: 480px;">
        <!-- Ken-Burns Slow Zooming Background -->
        <img
          src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/landing_hero.jpg' %>"
          alt="<%= listing.title %>"
          class="wl-hero-slide-bg"
          loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
        />
        <div class="wl-hero-overlay"></div>

        <div class="wl-container py-5 wl-hero-content d-flex align-items-center" style="min-height: 480px;">
          <div class="row w-100 align-items-center g-4 my-auto">
            <!-- Left Hero Content with Login / Register -->
            <div class="col-12 col-lg-7 text-white">
              <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-20 border border-white border-opacity-25 small mb-3">
                <i class="fa-solid fa-sparkles text-warning"></i>
                <span class="fw-semibold"><%= qObj.theme %></span>
              </div>
              <h1 class="display-4 fw-bold text-white mb-2" style="letter-spacing: -0.02em; text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
                Find your next stay or venue
              </h1>
              <p class="wl-hero-quote">
                “<%= qObj.quote %>”
              </p>

              <!-- CTA Buttons -->
              <div class="d-flex flex-wrap align-items-center gap-3 mb-4 pb-2">
                <a id="btn-login" href="/login" class="btn wl-btn-primary px-4 py-2" style="height: 46px;">
                  Login
                </a>
                <a
                  id="btn-register"
                  href="/signup"
                  class="btn wl-btn-outline px-4 py-2"
                  style="height: 46px; background-color: rgba(255, 255, 255, 0.12) !important; color: #FFFFFF !important; border: 1.5px solid rgba(255, 255, 255, 0.4) !important;"
                >
                  Register
                </a>
                <a
                  href="/listings/<%= listing.id %>"
                  class="btn btn-sm btn-outline-light d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill"
                  style="height: 46px; backdrop-filter: blur(8px); background-color: rgba(255,255,255,0.08);"
                >
                  <span>Explore <%= listing.title.length > 22 ? listing.title.substring(0, 20) + '...' : listing.title %></span>
                  <i class="fa-solid fa-arrow-right small"></i>
                </a>
              </div>

              <!-- Trust Badges Row -->
              <div class="d-flex flex-wrap gap-4 text-white text-opacity-90 pt-3 border-top border-white border-opacity-25 small">
                <div class="d-flex align-items-center gap-2">
                  <i class="fa-solid fa-shield-halved text-teal-100"></i>
                  <span>Verified Listings</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <i class="fa-solid fa-users text-teal-100"></i>
                  <span>Trusted Community</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <i class="fa-solid fa-tag text-teal-100"></i>
                  <span>Memorable Experiences</span>
                </div>
              </div>
            </div>

            <!-- Right Spotlight Glassmorphism Card for Current Highlighted Listing -->
            <div class="col-12 col-lg-5 d-none d-lg-block">
              <a href="/listings/<%= listing.id %>" class="text-decoration-none">
                <div class="wl-hero-glass-card">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                      <i class="fa-solid fa-star me-1"></i> Highlighted Listing
                    </span>
                    <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 rounded-pill fw-semibold">
                      &#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %> / night
                    </span>
                  </div>
                  <h3 class="h4 fw-bold text-white mb-2 text-truncate"><%= listing.title %></h3>
                  <div class="d-flex align-items-center gap-2 text-white text-opacity-90 small mb-3">
                    <i class="fa-solid fa-location-dot text-teal-200"></i>
                    <span><%= [listing.location, listing.country].filter(Boolean).join(", ") || 'Verified Venue' %></span>
                  </div>
                  <div class="d-flex align-items-center justify-content-between pt-2 border-top border-white border-opacity-25">
                    <span class="text-white-50 small">Click to book or view details</span>
                    <span class="btn btn-sm btn-light rounded-pill px-3 py-1 fw-bold text-dark">
                      View Stay <i class="fa-solid fa-chevron-right ms-1 small"></i>
                    </span>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Left & Right Carousel Controls -->
  <button class="carousel-control-prev wl-carousel-control prev d-none d-md-flex" type="button" data-bs-target="#heroDynamicSlider" data-bs-slide="prev" aria-label="Previous">
    <i class="fa-solid fa-chevron-left"></i>
  </button>
  <button class="carousel-control-next wl-carousel-control next d-none d-md-flex" type="button" data-bs-target="#heroDynamicSlider" data-bs-slide="next" aria-label="Next">
    <i class="fa-solid fa-chevron-right"></i>
  </button>
</section>

<!-- Main Container -->
<div class="wl-container py-5">
  <!-- Dual Role Cards (Customer & Owner) -->
  <div class="row g-4 mb-5">
    <!-- Customer Card -->
    <div class="col-12 col-md-6">
      <div class="wl-card h-100 shadow-sm border" style="border-radius: var(--wl-radius-lg); overflow: hidden;">
        <div class="row g-0 h-100">
          <div class="col-sm-5" style="min-height: 200px;">
            <img
              src="/images/customer_card.jpg"
              alt="Discover stays"
              class="w-100 h-100"
              style="object-fit: cover;"
              loading="lazy"
            />
          </div>
          <div class="col-sm-7 p-4 d-flex flex-direction-column flex-column justify-content-between">
            <div>
              <div class="text-uppercase fw-bold text-muted small mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                FOR CUSTOMERS
              </div>
              <h2 class="h5 fw-bold text-dark mb-2">
                Discover amazing stays and event venues
              </h2>
              <p class="text-muted small mb-3">
                Find and book unique hotels, holiday homes, and stunning venues for your special moments.
              </p>
            </div>
            <div>
              <a
                id="btn-register-customer"
                href="/signup?role=customer"
                class="btn wl-btn-primary"
              >
                Register as Customer
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Owner Card -->
    <div class="col-12 col-md-6">
      <div class="wl-card h-100 shadow-sm border" style="border-radius: var(--wl-radius-lg); overflow: hidden;">
        <div class="row g-0 h-100">
          <div class="col-sm-5" style="min-height: 200px;">
            <img
              src="/images/owner_card.jpg"
              alt="List property"
              class="w-100 h-100"
              style="object-fit: cover;"
              loading="lazy"
            />
          </div>
          <div class="col-sm-7 p-4 d-flex flex-direction-column flex-column justify-content-between">
            <div>
              <div class="text-uppercase fw-bold text-muted small mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                FOR PROPERTY AND VENUE OWNERS
              </div>
              <h2 class="h5 fw-bold text-dark mb-2">
                List your property or venue
              </h2>
              <p class="text-muted small mb-3">
                Reach thousands of travelers and event planners. Grow your business with WanderLust.
                <span class="d-block mt-1 fst-italic">Owner accounts are approved by an admin before you can add listings.</span>
              </p>
            </div>
            <div>
              <a
                id="btn-register-owner"
                href="/signup?role=owner"
                class="btn wl-btn-primary"
              >
                Register as Owner
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Venue Categorized Dynamic Collage Section -->
  <% const safeListings = (typeof listings !== 'undefined' && Array.isArray(listings)) ? listings : []; %>
  <div id="venueCollageSection" class="mt-5 wl-collage-section" data-hydrated="<%= safeListings.length > 0 ? 'true' : 'false' %>">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
      <div>
        <h2 class="h4 fw-bold text-dark mb-1">Explore Venues &amp; Stays by Category</h2>
        <p class="text-muted small mb-0">Discover handpicked destinations across curated venue collections</p>
      </div>
      <div class="d-flex align-items-center gap-3">
        <div class="wl-collage-cycle-indicator d-none d-md-inline-flex">
          <span class="wl-pulse-dot"></span>
          <span id="cycleStatusLabel">Dynamic spotlight active</span>
        </div>
        <a href="/listings" class="fw-semibold text-decoration-none d-flex align-items-center gap-1" style="color: var(--wl-teal-600);">
          <span id="allStaysCountText">View all stays<%= safeListings.length > 0 ? ' (' + safeListings.length + ')' : '' %></span>
          <i class="fa-solid fa-arrow-right small"></i>
        </a>
      </div>
    </div>

    <!-- Category Filter Navigation Pills -->
    <div class="wl-category-nav" id="venueCategoryNav">
      <button type="button" class="wl-category-btn active" data-category="all">
        <i class="fa-solid fa-compass"></i>
        <span>All Venues</span>
        <span class="wl-category-count" id="count-all"><%= safeListings.length %></span>
      </button>
      <button type="button" class="wl-category-btn" data-category="beach">
        <i class="fa-solid fa-umbrella-beach"></i>
        <span>Beach &amp; Waterfront</span>
        <span class="wl-category-count" id="count-beach">0</span>
      </button>
      <button type="button" class="wl-category-btn" data-category="mountain">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains &amp; Cabins</span>
        <span class="wl-category-count" id="count-mountain">0</span>
      </button>
      <button type="button" class="wl-category-btn" data-category="villa">
        <i class="fa-solid fa-landmark"></i>
        <span>Villas &amp; Estates</span>
        <span class="wl-category-count" id="count-villa">0</span>
      </button>
      <button type="button" class="wl-category-btn" data-category="urban">
        <i class="fa-solid fa-city"></i>
        <span>Urban &amp; Penthouses</span>
        <span class="wl-category-count" id="count-urban">0</span>
      </button>
      <button type="button" class="wl-category-btn" data-category="unique">
        <i class="fa-solid fa-gem"></i>
        <span>Unique &amp; Boutique</span>
        <span class="wl-category-count" id="count-unique">0</span>
      </button>
    </div>

    <!-- Dynamic Bento Collage Grid -->
    <div class="wl-collage-grid" id="venueCollageGrid">
      <!-- Dynamically rendered and animated collage cards -->
    </div>
  </div>
</div>

<!-- Embedded JSON Data of Database Listings for Fast Client-Side Dynamic Switching -->
<script id="venueListingsData" type="application/json">
  <%- JSON.stringify(safeListings) %>
</script>

<!-- Dynamic Collage Controller Script -->
<script>
  (function() {
    function categorizeListing(listing) {
      const text = ((listing.title || "") + " " + (listing.location || "") + " " + (listing.country || "")).toLowerCase();
      if (/beach|coast|ocean|lake|sea|water|island|cancun|malibu/i.test(text)) {
        return { id: "beach", name: "Beach & Waterfront", icon: "fa-umbrella-beach" };
      }
      if (/mountain|cabin|chalet|ski|forest|treehouse|aspen|verbier|tahoe|nature/i.test(text)) {
        return { id: "mountain", name: "Mountains & Cabins", icon: "fa-mountain" };
      }
      if (/villa|historic|estate|resort|lodge|safari|tuscany|serengeti|manor/i.test(text)) {
        return { id: "villa", name: "Villas & Estates", icon: "fa-landmark" };
      }
      if (/loft|penthouse|urban|city|downtown|apartment|hotel|shibuya|york|angeles/i.test(text)) {
        return { id: "urban", name: "Urban & Penthouses", icon: "fa-city" };
      }
      return { id: "unique", name: "Unique & Boutique", icon: "fa-gem" };
    }

    let allListings = [];
    try {
      const dataScript = document.getElementById("venueListingsData");
      if (dataScript && dataScript.textContent.trim()) {
        allListings = JSON.parse(dataScript.textContent.trim());
      }
    } catch (e) {
      allListings = [];
    }

    let currentCategory = "all";
    let spotlightOffset = 0;
    let autoCycleTimer = null;
    let isHovered = false;

    const grid = document.getElementById("venueCollageGrid");
    const nav = document.getElementById("venueCategoryNav");
    const cycleLabel = document.getElementById("cycleStatusLabel");
    const section = document.getElementById("venueCollageSection");

    function renderCollage(listings, category, offset) {
      if (!grid) return;

      // Filter by category
      let categoryMatches = category === "all" 
        ? listings 
        : listings.filter(l => categorizeListing(l).id === category);

      if (categoryMatches.length === 0) {
        categoryMatches = listings;
      }

      // Re-order based on spotlight offset for dynamic rotation
      const shifted = [];
      const len = categoryMatches.length;
      for (let i = 0; i < len; i++) {
        shifted.push(categoryMatches[(i + offset) % len]);
      }

      // If fewer than 5, backfill from remaining listings so collage layout stays balanced
      let displayItems = [...shifted];
      if (displayItems.length < 5) {
        const others = listings.filter(l => !displayItems.some(d => d.id === l.id));
        displayItems = displayItems.concat(others).slice(0, 5);
      } else {
        displayItems = displayItems.slice(0, 5);
      }

      // Trigger smooth CSS animation
      grid.classList.remove("wl-collage-animating");
      void grid.offsetWidth; // trigger reflow
      grid.classList.add("wl-collage-animating");

      grid.innerHTML = "";

      displayItems.forEach((item, index) => {
        const cat = categorizeListing(item);
        const isFeatured = index === 0;
        const link = document.createElement("a");
        link.href = "/listings/" + item.id;
        link.className = "wl-collage-item " + (isFeatured ? "featured" : "tile");

        const imgUrl = (item.image && item.image.url) ? item.image.url : "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb";
        const priceStr = "&#8377;" + Number(item.price || 0).toLocaleString("en-IN");
        const locStr = [item.location, item.country].filter(Boolean).join(", ") || "Verified Venue";

        link.innerHTML = `
          <img src="${imgUrl}" alt="${item.title}" loading="${isFeatured ? 'eager' : 'lazy'}">
          <div class="wl-collage-overlay">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <span class="wl-collage-badge">
                <i class="fa-solid ${cat.icon} text-teal-600"></i>
                <span>${cat.name}</span>
              </span>
              <span class="wl-collage-price-tag">
                ${priceStr} <span class="small fw-normal text-white-50">/ night</span>
              </span>
            </div>
            <div class="wl-collage-caption">
              <h${isFeatured ? '3' : '4'} class="wl-collage-title ${isFeatured ? '' : 'text-truncate'}">${item.title}</h${isFeatured ? '3' : '4'}>
              <div class="wl-collage-location ${isFeatured ? '' : 'text-truncate'}">
                <i class="fa-solid fa-location-dot"></i>
                <span>${locStr}</span>
              </div>
              ${isFeatured ? `
                <div class="mt-3">
                  <span class="btn wl-btn-primary px-3 py-2 btn-sm text-white fw-semibold">
                    Explore Venue <i class="fa-solid fa-arrow-right ms-1"></i>
                  </span>
                </div>
              ` : ''}
            </div>
          </div>
        `;
        grid.appendChild(link);
      });
    }

    function updateCategoryCounts(listings) {
      const counts = { all: listings.length, beach: 0, mountain: 0, villa: 0, urban: 0, unique: 0 };
      listings.forEach(l => {
        const c = categorizeListing(l).id;
        if (counts[c] !== undefined) counts[c]++;
      });
      Object.keys(counts).forEach(k => {
        const el = document.getElementById("count-" + k);
        if (el) el.textContent = counts[k];
      });
      const allText = document.getElementById("allStaysCountText");
      if (allText) allText.textContent = "View all stays (" + listings.length + ")";
    }

    function startAutoCycle() {
      if (autoCycleTimer) clearInterval(autoCycleTimer);
      autoCycleTimer = setInterval(() => {
        if (isHovered || allListings.length === 0) return;
        spotlightOffset = (spotlightOffset + 1) % allListings.length;
        renderCollage(allListings, currentCategory, spotlightOffset);
      }, 5500);
    }

    // Category button click handling
    if (nav) {
      nav.addEventListener("click", e => {
        const btn = e.target.closest(".wl-category-btn");
        if (!btn) return;
        nav.querySelectorAll(".wl-category-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentCategory = btn.getAttribute("data-category") || "all";
        spotlightOffset = 0;
        renderCollage(allListings, currentCategory, spotlightOffset);
      });
    }

    // Hover pause mechanism
    if (section) {
      section.addEventListener("mouseenter", () => {
        isHovered = true;
        if (cycleLabel) cycleLabel.textContent = "Spotlight paused";
      });
      section.addEventListener("mouseleave", () => {
        isHovered = false;
        if (cycleLabel) cycleLabel.textContent = "Dynamic spotlight active";
      });
    }

    // Initialize or hydrate from /listings if needed
    if (allListings && allListings.length > 0) {
      updateCategoryCounts(allListings);
      renderCollage(allListings, "all", 0);
      startAutoCycle();
    } else {
      // Hydrate via client-side fetch from /listings
      fetch("/listings")
        .then(r => r.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, "text/html");
          const cards = Array.from(doc.querySelectorAll(".wl-listing-card"));
          if (!cards || cards.length === 0) return;

          allListings = cards.map((card, idx) => {
            const anchor = card.closest("a");
            const href = anchor ? anchor.getAttribute("href") : "/listings";
            const idMatch = href.match(/\/listings\/(\d+)/);
            const id = idMatch ? idMatch[1] : (idx + 1);
            const img = card.querySelector("img");
            const titleEl = card.querySelector(".wl-listing-title");
            const locEl = card.querySelector(".wl-listing-location");
            const priceEl = card.querySelector(".wl-listing-price");
            const priceClean = priceEl ? priceEl.textContent.replace(/[^\d]/g, "") : "0";

            return {
              id: id,
              title: titleEl ? titleEl.textContent.trim() : "Venue Stay",
              location: locEl ? locEl.textContent.trim() : "Location",
              country: "",
              price: parseInt(priceClean, 10) || 5000,
              image: { url: img ? img.getAttribute("src") : "" }
            };
          });

          updateCategoryCounts(allListings);
          renderCollage(allListings, "all", 0);
          startAutoCycle();
        })
        .catch(err => console.error("Error hydrating collage:", err));
    }
  })();
</script>
