<% layout("layouts/boilerplate") -%>

<!-- Hero Section with Scenic Panorama -->
<section
  class="position-relative text-white py-5 d-flex align-items-center"
  style="
    min-height: 460px;
    background: linear-gradient(180deg, rgba(14, 56, 66, 0.72) 0%, rgba(11, 47, 58, 0.85) 100%),
      url('/images/landing_hero.jpg') center / cover no-repeat;
  "
>
  <div class="wl-container py-4">
    <div class="row">
      <div class="col-12 col-lg-8">
        <h1 class="display-4 fw-bold text-white mb-3" style="letter-spacing: -0.02em;">
          Find your next stay or venue
        </h1>
        <p class="fs-5 text-white text-opacity-90 mb-4 fw-normal" style="max-width: 620px;">
          WanderLust connects customers with verified hotel owners and event planners.
        </p>

        <!-- CTA Buttons -->
        <div class="d-flex flex-wrap gap-3 mb-4 pb-2">
          <a id="btn-login" href="/login" class="btn wl-btn-primary px-4 py-2" style="height: 46px;">
            Login
          </a>
          <a
            id="btn-register"
            href="/signup"
            class="btn wl-btn-outline px-4 py-2"
            style="height: 46px; background-color: rgba(255, 255, 255, 0.12) !important; color: #FFFFFF !important; border: 1.5px solid rgba(255, 255, 255, 0.4) !important;"
          >
            Register
          </a>
        </div>

        <!-- Trust Badges Row -->
        <div class="d-flex flex-wrap gap-4 text-white text-opacity-90 pt-3 border-top border-white border-opacity-25 small">
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-shield-halved text-teal-100"></i>
            <span>Verified Listings</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-users text-teal-100"></i>
            <span>Trusted Community</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-tag text-teal-100"></i>
            <span>Memorable Experiences</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Main Container -->
<div class="wl-container py-5">
  <!-- Dual Role Cards (Customer & Owner) -->
  <div class="row g-4 mb-5">
    <!-- Customer Card -->
    <div class="col-12 col-md-6">
      <div class="wl-card h-100 shadow-sm border" style="border-radius: var(--wl-radius-lg); overflow: hidden;">
        <div class="row g-0 h-100">
          <div class="col-sm-5" style="min-height: 200px;">
            <img
              src="/images/customer_card.jpg"
              alt="Discover stays"
              class="w-100 h-100"
              style="object-fit: cover;"
              loading="lazy"
            />
          </div>
          <div class="col-sm-7 p-4 d-flex flex-direction-column flex-column justify-content-between">
            <div>
              <div class="text-uppercase fw-bold text-muted small mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                FOR CUSTOMERS
              </div>
              <h2 class="h5 fw-bold text-dark mb-2">
                Discover amazing stays and event venues
              </h2>
              <p class="text-muted small mb-3">
                Find and book unique hotels, holiday homes, and stunning venues for your special moments.
              </p>
            </div>
            <div>
              <a
                id="btn-register-customer"
                href="/signup?role=customer"
                class="btn wl-btn-primary"
              >
                Register as Customer
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Owner Card -->
    <div class="col-12 col-md-6">
      <div class="wl-card h-100 shadow-sm border" style="border-radius: var(--wl-radius-lg); overflow: hidden;">
        <div class="row g-0 h-100">
          <div class="col-sm-5" style="min-height: 200px;">
            <img
              src="/images/owner_card.jpg"
              alt="List property"
              class="w-100 h-100"
              style="object-fit: cover;"
              loading="lazy"
            />
          </div>
          <div class="col-sm-7 p-4 d-flex flex-direction-column flex-column justify-content-between">
            <div>
              <div class="text-uppercase fw-bold text-muted small mb-1" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                FOR PROPERTY AND VENUE OWNERS
              </div>
              <h2 class="h5 fw-bold text-dark mb-2">
                List your property or venue
              </h2>
              <p class="text-muted small mb-3">
                Reach thousands of travelers and event planners. Grow your business with WanderLust.
                <span class="d-block mt-1 fst-italic">Owner accounts are approved by an admin before you can add listings.</span>
              </p>
            </div>
            <div>
              <a
                id="btn-register-owner"
                href="/signup?role=owner"
                class="btn wl-btn-primary"
              >
                Register as Owner
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Dynamic Database Listings Showcase Carousel & Slideshow -->
  <div class="mt-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <h2 class="h4 fw-bold text-dark mb-1">Featured Stays &amp; Venues</h2>
        <p class="text-muted small mb-0">Explore handpicked stays directly from our verified host community</p>
      </div>
      <a href="/listings" class="fw-semibold text-decoration-none d-flex align-items-center gap-1" style="color: var(--wl-teal-600);">
        <span>View all stays<%= (listings && listings.length) ? ' (' + listings.length + ')' : '' %></span>
        <i class="fa-solid fa-arrow-right small"></i>
      </a>
    </div>

    <% if (listings && listings.length > 0) { %>
      <!-- High-Impact Auto-Playing Carousel Slideshow -->
      <div id="listingHeroCarousel" class="carousel slide carousel-fade wl-carousel-wrapper mb-5" data-bs-ride="carousel" data-bs-interval="4000">
        <!-- Indicators -->
        <div class="carousel-indicators wl-carousel-indicators">
          <% listings.slice(0, Math.min(listings.length, 6)).forEach((item, idx) => { %>
            <button
              type="button"
              data-bs-target="#listingHeroCarousel"
              data-bs-slide-to="<%= idx %>"
              class="<%= idx === 0 ? 'active' : '' %>"
              aria-current="<%= idx === 0 ? 'true' : 'false' %>"
              aria-label="Slide <%= idx + 1 %>"
            ></button>
          <% }); %>
        </div>

        <!-- Carousel Slides -->
        <div class="carousel-inner">
          <% listings.slice(0, Math.min(listings.length, 6)).forEach((listing, idx) => { %>
            <div class="carousel-item <%= idx === 0 ? 'active' : '' %> wl-carousel-item">
              <img
                src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1400&q=80' %>"
                class="wl-carousel-img"
                alt="<%= listing.title %>"
                loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
              />
              <div class="wl-carousel-overlay">
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <span class="wl-carousel-badge">
                    <i class="fa-solid fa-star text-warning"></i>
                    <span>Featured Destination</span>
                  </span>
                  <span class="badge bg-dark bg-opacity-75 text-white px-3 py-2 rounded-pill fs-6 fw-semibold shadow-sm">
                    &#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %>
                    <span class="small fw-normal text-white-50">/ night</span>
                  </span>
                </div>
                <div class="wl-carousel-caption">
                  <h3 class="display-6 fw-bold text-white mb-2" style="text-shadow: 0 2px 8px rgba(0,0,0,0.45);"><%= listing.title %></h3>
                  <% if (listing.location || listing.country) { %>
                    <p class="fs-6 text-white text-opacity-90 mb-3 d-flex align-items-center gap-2">
                      <i class="fa-solid fa-location-dot text-teal-100"></i>
                      <span><%= [listing.location, listing.country].filter(Boolean).join(", ") %></span>
                    </p>
                  <% } %>
                  <div class="d-flex flex-wrap gap-2 mt-3">
                    <a href="/listings/<%= listing.id %>" class="btn wl-btn-primary px-4 py-2">
                      View Listing <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                    <a href="/listings" class="btn btn-outline-light px-4 py-2" style="backdrop-filter: blur(4px);">
                      Explore All Properties
                    </a>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev wl-carousel-control prev" type="button" data-bs-target="#listingHeroCarousel" data-bs-slide="prev" aria-label="Previous">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="carousel-control-next wl-carousel-control next" type="button" data-bs-target="#listingHeroCarousel" data-bs-slide="next" aria-label="Next">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>

      <!-- Moving Marquee Slideshow of All Database Listings -->
      <div class="mt-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h3 class="h5 fw-bold text-dark mb-0">Live From Our Catalog</h3>
          <span class="text-muted small">Continuous moving slideshow &bull; Hover to pause</span>
        </div>

        <div class="wl-marquee-container">
          <div class="wl-marquee-track">
            <!-- Render 2 continuous loops for seamless infinite scrolling -->
            <% for (let loop = 0; loop < 2; loop++) { %>
              <% listings.forEach((listing) => { %>
                <div class="wl-marquee-card">
                  <a href="/listings/<%= listing.id %>" class="text-decoration-none">
                    <div class="wl-listing-card">
                      <div class="wl-listing-img-wrap">
                        <img
                          src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80' %>"
                          alt="<%= listing.title %>"
                          class="wl-listing-img"
                          loading="lazy"
                        />
                        <span class="wl-heart-btn" aria-hidden="true">
                          <i class="fa-regular fa-heart"></i>
                        </span>
                      </div>
                      <div class="wl-listing-body">
                        <div class="wl-listing-title text-truncate"><%= listing.title %></div>
                        <div class="wl-listing-location">
                          <i class="fa-solid fa-location-dot"></i>
                          <span><%= [listing.location, listing.country].filter(Boolean).join(", ") || 'Verified Location' %></span>
                        </div>
                        <div class="wl-listing-footer">
                          <span class="wl-listing-price">&#8377;<%= Number(listing.price || 0).toLocaleString("en-IN") %></span>
                          <span class="wl-listing-unit">/ night</span>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>
      </div>
    <% } else { %>
      <!-- Fallback when no listings yet -->
      <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
          <a href="/listings" class="text-decoration-none">
            <div class="wl-listing-card">
              <div class="wl-listing-img-wrap">
                <img
                  src="https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80"
                  alt="The Pinewood Chalet"
                  class="wl-listing-img"
                  loading="lazy"
                />
              </div>
              <div class="wl-listing-body">
                <div class="wl-listing-title text-truncate">The Pinewood Chalet</div>
                <div class="wl-listing-location">
                  <i class="fa-solid fa-location-dot"></i>
                  <span>Manali, Himachal Pradesh</span>
                </div>
                <div class="wl-listing-footer">
                  <span class="wl-listing-price">&#8377;8,500</span>
                  <span class="wl-listing-unit">/ night</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      </div>
    <% } %>
  </div>
</div>
